<!--
    DevPilot — IT Automation Hub v1.0
    ExternalToolsView.xaml — Tools tab (Phase 10B — fixed brush names)
    3 built-in cards + dynamic custom tool cards with Add / Remove
    Author: Bogdan Murar (Z003FU5C) — Siemens AG
-->
<UserControl x:Class="DevPilot.UI.Views.ExternalToolsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource BgMainBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24" MaxWidth="760">

            <!-- ── Page title ──────────────────────────────────────────── -->
            <TextBlock Text="🔧 External Tools Launchers"
                       FontSize="18" FontWeight="Bold"
                       Foreground="{DynamicResource AccentBrush}"
                       Margin="0,0,0,4"/>
            <TextBlock Text="Launch external tools. DevPilot only starts the executable — it never modifies these tools. Configure paths in Settings → Paths."
                       Foreground="{DynamicResource FgSecondaryBrush}"
                       FontSize="12" TextWrapping="Wrap"
                       Margin="0,0,0,24"/>

            <!-- ════════════════════════════════════════════════════════════
                 CARD 1 — DataCleansing Solution
            ════════════════════════════════════════════════════════════ -->
            <Border Background="{DynamicResource BgCardBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="8"
                    Padding="20" Margin="0,0,0,16">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <TextBlock Text="🗃️" FontSize="22"
                                   VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="DataCleansing Solution"
                                       FontSize="15" FontWeight="SemiBold"
                                       Foreground="{DynamicResource FgPrimaryBrush}"/>
                            <TextBlock Text="GSP / OMNITRACKER data cleansing automation tool"
                                       FontSize="11"
                                       Foreground="{DynamicResource FgSecondaryBrush}"/>
                        </StackPanel>
                    </StackPanel>
                    <Border Background="{DynamicResource StatusWarnBgBrush}"
                            BorderBrush="{DynamicResource StatusWarnBrush}"
                            BorderThickness="1" CornerRadius="4"
                            Padding="10,6" Margin="0,0,0,12"
                            Visibility="{Binding DcWarningVisibility}">
                        <TextBlock Text="{Binding DcWarning}"
                                   Foreground="#FF9800" FontSize="12" TextWrapping="Wrap"/>
                    </Border>
                    <TextBlock Text="{Binding DcStatusText}"
                               FontSize="13" FontWeight="SemiBold" Margin="0,0,0,16">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground"
                                        Value="{DynamicResource FgSecondaryBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DcIsRunning}" Value="True">
                                        <Setter Property="Foreground" Value="#4CAF50"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="▶  Launch DataCleansing"
                                Height="34" Padding="18,0"
                                Style="{DynamicResource PrimaryButtonStyle}"
                                Command="{Binding LaunchDataCleansingCommand}"
                                ToolTip="Starts DataCleansing.MasterApp.Starter.exe"
                                Margin="0,0,10,0"/>
                        <Button Content="📂  Open Folder"
                                Height="34" Padding="14,0"
                                Style="{DynamicResource SecondaryButtonStyle}"
                                Command="{Binding OpenFolderDataCleansingCommand}"
                                ToolTip="Open executable folder in Explorer"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ════════════════════════════════════════════════════════════
                 CARD 2 — TestClientUtilityApp
            ════════════════════════════════════════════════════════════ -->
            <Border Background="{DynamicResource BgCardBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="8"
                    Padding="20" Margin="0,0,0,16">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <TextBlock Text="🧪" FontSize="22"
                                   VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="TestClientUtilityApp"
                                       FontSize="15" FontWeight="SemiBold"
                                       Foreground="{DynamicResource FgPrimaryBrush}"/>
                            <TextBlock Text="Test bench automation client"
                                       FontSize="11"
                                       Foreground="{DynamicResource FgSecondaryBrush}"/>
                        </StackPanel>
                    </StackPanel>
                    <Border Background="{DynamicResource StatusWarnBgBrush}"
                            BorderBrush="{DynamicResource StatusWarnBrush}"
                            BorderThickness="1" CornerRadius="4"
                            Padding="10,6" Margin="0,0,0,12"
                            Visibility="{Binding TcWarningVisibility}">
                        <TextBlock Text="{Binding TcWarning}"
                                   Foreground="#FF9800" FontSize="12" TextWrapping="Wrap"/>
                    </Border>
                    <TextBlock Text="{Binding TcStatusText}"
                               FontSize="13" FontWeight="SemiBold" Margin="0,0,0,16">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground"
                                        Value="{DynamicResource FgSecondaryBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding TcIsRunning}" Value="True">
                                        <Setter Property="Foreground" Value="#4CAF50"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="▶  Launch TestClientUtilityApp"
                                Height="34" Padding="18,0"
                                Style="{DynamicResource PrimaryButtonStyle}"
                                Command="{Binding LaunchTestClientCommand}"
                                ToolTip="Starts TestClientUtilityApp.exe"
                                Margin="0,0,10,0"/>
                        <Button Content="📂  Open Folder"
                                Height="34" Padding="14,0"
                                Style="{DynamicResource SecondaryButtonStyle}"
                                Command="{Binding OpenFolderTestClientCommand}"
                                ToolTip="Open executable folder in Explorer"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ════════════════════════════════════════════════════════════
                 CARD 3 — TC Management Local Starter
            ════════════════════════════════════════════════════════════ -->
            <Border Background="{DynamicResource BgCardBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="8"
                    Padding="20" Margin="0,0,0,16">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <TextBlock Text="⚙️" FontSize="22"
                                   VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="TC Management Local Starter"
                                       FontSize="15" FontWeight="SemiBold"
                                       Foreground="{DynamicResource FgPrimaryBrush}"/>
                            <TextBlock Text="Test bench management local application starter"
                                       FontSize="11"
                                       Foreground="{DynamicResource FgSecondaryBrush}"/>
                        </StackPanel>
                    </StackPanel>
                    <Border Background="{DynamicResource StatusWarnBgBrush}"
                            BorderBrush="{DynamicResource StatusWarnBrush}"
                            BorderThickness="1" CornerRadius="4"
                            Padding="10,6" Margin="0,0,0,12"
                            Visibility="{Binding MgmtWarningVisibility}">
                        <TextBlock Text="{Binding MgmtWarning}"
                                   Foreground="#FF9800" FontSize="12" TextWrapping="Wrap"/>
                    </Border>
                    <TextBlock Text="{Binding MgmtStatusText}"
                               FontSize="13" FontWeight="SemiBold" Margin="0,0,0,16">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground"
                                        Value="{DynamicResource FgSecondaryBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding MgmtIsRunning}" Value="True">
                                        <Setter Property="Foreground" Value="#4CAF50"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="▶  Launch TC Mgmt Starter"
                                Height="34" Padding="18,0"
                                Style="{DynamicResource PrimaryButtonStyle}"
                                Command="{Binding LaunchTcMgmtStarterCommand}"
                                ToolTip="Starts TCMgmtLocalAppStarter.exe"
                                Margin="0,0,10,0"/>
                        <Button Content="📂  Open Folder"
                                Height="34" Padding="14,0"
                                Style="{DynamicResource SecondaryButtonStyle}"
                                Command="{Binding OpenFolderTcMgmtStarterCommand}"
                                ToolTip="Open executable folder in Explorer"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ════════════════════════════════════════════════════════════
                 CUSTOM TOOLS — user-defined, persisted in config.json
            ════════════════════════════════════════════════════════════ -->
            <Separator Margin="0,8,0,20"
                       Background="{DynamicResource BorderBrush}"/>

            <!-- Section header -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="⚡  Custom Tools"
                               FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentBrush}"/>
                    <TextBlock Text="Your own tools — launched via Process.Start, no arguments."
                               FontSize="11"
                               Foreground="{DynamicResource FgSecondaryBrush}"
                               Margin="0,2,0,0"/>
                </StackPanel>
                <Button Grid.Column="1"
                        Content="＋  Add Tool"
                        Height="34" Padding="16,0"
                        VerticalAlignment="Center"
                        Style="{DynamicResource PrimaryButtonStyle}"
                        Command="{Binding AddCustomToolCommand}"
                        ToolTip="Add a new custom tool"/>
            </Grid>

            <!-- Empty state hint -->
            <TextBlock Text="No custom tools yet. Click  ＋ Add Tool  above to get started."
                       FontSize="12" FontStyle="Italic"
                       Foreground="{DynamicResource FgMutedBrush}"
                       HorizontalAlignment="Center"
                       Margin="0,4,0,20">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CustomTools.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- Custom tool cards - x:Name required for ElementName binding -->
            <ItemsControl x:Name="CustomToolsList"
                          ItemsSource="{Binding CustomTools}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource BgCardBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1" CornerRadius="8"
                                Padding="20" Margin="0,0,0,12">
                            <StackPanel>

                                <!-- Card header: icon + name/desc + Edit + Remove -->
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
										<ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- Icon + title -->
                                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                                        <TextBlock Text="{Binding Entry.Icon}"
                                                   FontSize="22"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,12,0"/>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Entry.Name}"
                                                       FontSize="15" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource FgPrimaryBrush}"/>
                                            <TextBlock Text="{Binding Entry.Description}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource FgSecondaryBrush}"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <!-- Edit button -->
                                    <Button Grid.Column="1"
                                            Content="✏ Edit"
                                            Height="28" Padding="10,0"
                                            FontSize="11"
                                            VerticalAlignment="Top"
                                            Style="{DynamicResource SecondaryButtonStyle}"
                                            Command="{Binding DataContext.EditCustomToolCommand,
                                                      ElementName=CustomToolsList}"
                                            CommandParameter="{Binding}"
                                            Margin="0,0,6,0"/>
                                    <!-- Remove button -->
                                    <Button Grid.Column="2"
                                            Content="✕ Remove"
                                            Height="28" Padding="10,0"
                                            FontSize="11"
                                            VerticalAlignment="Top"
                                            Style="{DynamicResource DangerButtonStyle}"
                                            Command="{Binding DataContext.RemoveCustomToolCommand,
                                                      ElementName=CustomToolsList}"
                                            CommandParameter="{Binding}"/>
                                </Grid>

                                <!-- Warning banner -->
                                <Border Background="{DynamicResource StatusWarnBgBrush}"
                                        BorderBrush="{DynamicResource StatusWarnBrush}"
                                        BorderThickness="1" CornerRadius="4"
                                        Padding="10,6" Margin="0,0,0,12"
                                        Visibility="{Binding WarningVisibility}">
                                    <TextBlock Text="{Binding Warning}"
                                               Foreground="{DynamicResource StatusWarnBrush}"
                                               FontSize="12" TextWrapping="Wrap"/>
                                </Border>

                                <!-- Live status -->
                                <TextBlock Text="{Binding StatusText}"
                                           FontSize="13" FontWeight="SemiBold"
                                           Margin="0,0,0,16">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground"
                                                    Value="{DynamicResource FgSecondaryBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                    <Setter Property="Foreground" Value="#4CAF50"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <!-- Action buttons -->
                                <StackPanel Orientation="Horizontal">
                                    <Button Height="34" Padding="18,0"
                                            Style="{DynamicResource PrimaryButtonStyle}"
                                            Command="{Binding LaunchCommand}"
                                            Margin="0,0,10,0">
                                        <TextBlock>
                                            <Run Text="▶  Launch "/>
                                            <Run Text="{Binding Entry.Name}"/>
                                        </TextBlock>
                                    </Button>
                                    <Button Content="📂  Open Folder"
                                            Height="34" Padding="14,0"
                                            Style="{DynamicResource SecondaryButtonStyle}"
                                            Command="{Binding OpenFolderCommand}"
                                            ToolTip="Open executable folder in Explorer"/>
                                </StackPanel>

                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>
</UserControl>
