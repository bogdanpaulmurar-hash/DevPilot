<UserControl x:Class="DevPilot.UI.Views.ZonePilotView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DevPilot.UI.ViewModels">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,4,32,32" MaxWidth="820" HorizontalAlignment="Left">
            <TextBlock Text="ZonePilot" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource PageSubtitle}" TextWrapping="Wrap"/>

            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                <Button Style="{StaticResource AccentButton}" Content="Save and reload" Command="{Binding SaveCommand}"
                        IsEnabled="{Binding CanSave}" Margin="0,0,8,0"/>
                <Button Content="Refresh" Command="{Binding RefreshCommand}" Margin="0,0,8,0"/>
                <Button Style="{StaticResource GhostButton}" Content="Open settings.json" Command="{Binding OpenFileCommand}" Margin="0,0,8,0"/>
                <Button Style="{StaticResource GhostButton}" Content="Layout editor" Command="{Binding EditorCommand}"
                        IsEnabled="{Binding HasExe}"/>
            </StackPanel>
            <TextBlock Text="Working…" Style="{StaticResource Hint}" Margin="0,8,0,0"
                       Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
            <TextBlock Text="{Binding Status}" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,8,0,0"/>

            <Border Style="{StaticResource Card}" Margin="0,16,0,12">
                <StackPanel>
                    <TextBlock Text="Layouts" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="Default layout (monitors without their own layout)" Style="{StaticResource FieldLabel}"/>
                    <ComboBox ItemsSource="{Binding Layouts}" DisplayMemberPath="Name" SelectedValuePath="Id"
                              SelectedValue="{Binding DefaultLayoutId}" HorizontalAlignment="Left" MinWidth="260" Margin="0,4,0,12"/>

                    <TextBlock Text="Per monitor" Style="{StaticResource FieldLabel}"/>
                    <ItemsControl ItemsSource="{Binding Monitors}" Margin="0,4,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ZonePilotMonitorVM}">
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="260"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Title}" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="1" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding LayoutId}"
                                              ItemsSource="{Binding DataContext.MonitorChoices, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding MonitorHint}" Style="{StaticResource Hint}" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Drag to snap" Style="{StaticResource SectionTitle}"/>
                    <CheckBox Style="{StaticResource Switch}" Content="Show zones while dragging a window" IsChecked="{Binding DragEnabled}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0" IsEnabled="{Binding DragEnabled}">
                        <TextBlock Text="Key to hold while dragging" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <ComboBox ItemsSource="{x:Static vm:ZonePilotViewModel.DragModifiers}" SelectedItem="{Binding DragModifier}" MinWidth="120"/>
                    </StackPanel>
                    <TextBlock Text="None shows the zones on every drag. Holding the other of Ctrl / Alt as well stretches the window over several zones." Style="{StaticResource Hint}" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Hotkeys" Style="{StaticResource SectionTitle}"/>
                    <CheckBox Style="{StaticResource Switch}" Content="Use ZonePilot's hotkeys" IsChecked="{Binding HotkeysEnabled}"/>
                    <ItemsControl ItemsSource="{Binding Hotkeys}" Margin="0,10,0,0" IsEnabled="{Binding HotkeysEnabled}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ZonePilotHotkeyVM}">
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="220"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="{Binding Label}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"/>
                                    <TextBox Grid.Column="1" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Error}" Foreground="{DynamicResource DangerBrush}"
                                               Style="{StaticResource Hint}" TextWrapping="Wrap"
                                               Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="Write them as Win+Shift+Z or Ctrl+Alt+Win+Left. Leave a field empty to switch that hotkey off." Style="{StaticResource Hint}" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
