<UserControl x:Class="DevPilot.UI.Views.AppLauncherView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource BgMainBrush}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ── Title ─────────────────────────────────────────────────── -->
        <TextBlock Grid.Row="0"
                   Text="🚀  App Launcher"
                   FontSize="18" FontWeight="Bold"
                   Foreground="{DynamicResource AccentBrush}"
                   Margin="0,0,0,10"/>

        <!-- ── Filter bar + Add button ──────────────────────────────── -->
        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0"
                     Height="32"
                     Style="{DynamicResource InputStyle}"
                     Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Filter by name…"/>
            <Button Grid.Column="1"
                    Content="＋  Add"
                    Command="{Binding AddCommand}"
                    Width="90" Height="32" Margin="6,0,0,0"
                    Style="{DynamicResource PrimaryButtonStyle}"/>
        </Grid>

        <!-- ── App list ─────────────────────────────────────────────── -->
        <ListView Grid.Row="2"
                  ItemsSource="{Binding FilteredEntries}"
                  SelectedItem="{Binding SelectedEntry, Mode=TwoWay}"
                  ItemContainerStyle="{DynamicResource ListViewItemStyle}"
                  Background="{DynamicResource BgCardBrush}"
                  Foreground="{DynamicResource FgPrimaryBrush}"
                  BorderBrush="{DynamicResource BorderBrush}"
                  BorderThickness="1"
                  MouseDoubleClick="ListView_MouseDoubleClick">
            <ListView.View>
                <GridView ColumnHeaderContainerStyle="{DynamicResource GridViewColumnHeaderStyle}">

                    <GridViewColumn Header="Icon" Width="44">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="📄" FontSize="15"
                                           HorizontalAlignment="Center"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <GridViewColumn Header="Name"
                                    DisplayMemberBinding="{Binding Name}"
                                    Width="190"/>

                    <GridViewColumn Header="Type"
                                    DisplayMemberBinding="{Binding Type}"
                                    Width="110"/>

                    <GridViewColumn Header="Target"
                                    DisplayMemberBinding="{Binding Path}"
                                    Width="420"/>
                </GridView>
            </ListView.View>
        </ListView>

        <!-- ── Action buttons ───────────────────────────────────────── -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,8,0,4">

            <Button Content="▶  Launch"
                    Command="{Binding LaunchCommand}"
                    Width="100" Height="32" Margin="0,0,8,0"
                    Style="{DynamicResource PrimaryButtonStyle}"
                    ToolTip="Launch selected app (or double-click row)"/>

            <Button Content="✏  Edit"
                    Command="{Binding EditCommand}"
                    Width="80" Height="32" Margin="0,0,8,0"
                    Style="{DynamicResource SecondaryButtonStyle}"
                    ToolTip="Edit selected entry"/>

            <Button Content="⬆"
                    Command="{Binding MoveUpCommand}"
                    Width="48" Height="32" Margin="0,0,4,0"
                    FontSize="15"
                    Style="{DynamicResource SecondaryButtonStyle}"
                    ToolTip="Move selected entry up"/>

            <Button Content="⬇"
                    Command="{Binding MoveDownCommand}"
                    Width="48" Height="32" Margin="0,0,4,0"
                    FontSize="15"
                    Style="{DynamicResource SecondaryButtonStyle}"
                    ToolTip="Move selected entry down"/>

            <Button Content="🗑  Remove"
                    Command="{Binding RemoveCommand}"
                    Width="103" Height="32"
                    Style="{DynamicResource DangerButtonStyle}"
                    ToolTip="Remove selected entry"/>

        </StackPanel>

        <!-- ── Status bar ───────────────────────────────────────────── -->
        <TextBlock Grid.Row="4"
                   Text="{Binding StatusMessage}"
                   Foreground="{DynamicResource FgMutedBrush}"
                   FontSize="11" Margin="0,2,0,0"/>
    </Grid>
</UserControl>
