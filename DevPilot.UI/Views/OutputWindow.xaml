<Window x:Class="DevPilot.UI.Views.OutputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Output" Icon="/Assets/icon.ico"
        Width="820" Height="520" MinWidth="420" MinHeight="260"
        WindowStartupLocation="CenterScreen" Topmost="True"
        Background="{DynamicResource WindowBgBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBox x:Name="Body" IsReadOnly="True" TextWrapping="NoWrap" AcceptsReturn="True"
                 HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                 FontFamily="{StaticResource MonoFont}" FontSize="12.5" Padding="10"
                 Background="{DynamicResource Surface2Brush}" Foreground="{DynamicResource TextBrush}"
                 BorderBrush="{DynamicResource BorderBrush}"/>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Copy all" MinWidth="80" Click="Copy_Click"/>
            <Button Content="Close" MinWidth="80" Margin="8,0,0,0" IsCancel="True" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
