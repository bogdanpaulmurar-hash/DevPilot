<UserControl x:Class="DevPilot.UI.Views.JigglerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource BgMainBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0"
                   Text="🖱️  Mouse Jiggler"
                   FontSize="20" FontWeight="Bold"
                   Foreground="{DynamicResource AccentBrush}"
                   HorizontalAlignment="Center" Margin="0,0,0,6"/>

        <TextBlock Grid.Row="1"
                   Text="Prevents session timeout by micro-moving the cursor."
                   FontSize="12" Foreground="{DynamicResource FgMutedBrush}"
                   HorizontalAlignment="Center" Margin="0,0,0,28"
                   TextWrapping="Wrap" TextAlignment="Center"/>

        <!-- Status badge -->
        <Border Grid.Row="2"
                Background="{DynamicResource BgSurfaceBrush}"
                CornerRadius="6" Padding="16,12" Margin="0,0,0,28">
            <TextBlock Text="{Binding StatusText}"
                       FontSize="14" FontWeight="SemiBold"
                       Foreground="{DynamicResource AccentBrush}"
                       HorizontalAlignment="Center"/>
        </Border>

        <!-- Toggle button -->
        <Button Grid.Row="3"
                Content="{Binding ToggleLabel}"
                Command="{Binding ToggleCommand}"
                Width="160" Height="40"
                HorizontalAlignment="Center"
                Margin="0,0,0,24"
                Style="{DynamicResource PrimaryButtonStyle}"/>

        <!-- Interval -->
        <StackPanel Grid.Row="4" Orientation="Vertical" Margin="0,0,0,12">
            <TextBlock Text="{Binding IntervalLabel}"
                       FontSize="12"
                       Foreground="{DynamicResource FgMutedBrush}"
                       HorizontalAlignment="Center" Margin="0,0,0,6"/>
            <Slider Minimum="5" Maximum="300"
                    Value="{Binding IntervalSeconds}"
                    IsEnabled="{Binding IsNotRunning}"
                    Width="260" HorizontalAlignment="Center"
                    TickFrequency="5" IsSnapToTickEnabled="True"/>
        </StackPanel>
    </Grid>
</UserControl>
