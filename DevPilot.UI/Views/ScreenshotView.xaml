<UserControl x:Class="DevPilot.UI.Views.ScreenshotView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource BgMainBrush}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0"
                   Text="📷  Screenshot Tool"
                   FontSize="18" FontWeight="SemiBold"
                   Foreground="{DynamicResource AccentBrush}"
                   Margin="0,0,0,12"/>

        <!-- Capture buttons -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
            <Button Content="🖥  Full Screen"
                    Command="{Binding CaptureFullScreenCommand}"
                    Width="140" Height="36" Margin="0,0,8,0"
                    Style="{DynamicResource PrimaryButtonStyle}"/>
            <Button Content="🪟  Active Window"
                    Command="{Binding CaptureActiveWindowCommand}"
                    Width="140" Height="36" Margin="0,0,8,0"
                    Style="{DynamicResource SecondaryButtonStyle}"/>
        </StackPanel>

        <!-- Action buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,12">
            <Button Content="📋  Copy to Clipboard"
                    Command="{Binding CopyToClipboardCommand}"
                    Width="160" Height="32" Margin="0,0,8,0"
                    Style="{DynamicResource SecondaryButtonStyle}"/>
            <Button Content="📁  Open Folder"
                    Command="{Binding OpenFolderCommand}"
                    Width="130" Height="32" Margin="0,0,8,0"
                    Style="{DynamicResource SecondaryButtonStyle}"/>
            <Button Content="✏  Annotate"
                    Command="{Binding OpenAnnotationEditorCommand}"
                    Width="110" Height="32"
                    Style="{DynamicResource SecondaryButtonStyle}"/>
        </StackPanel>

        <!-- History list + Status -->
        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{DynamicResource BgCardBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="4">
                <ListBox ItemsSource="{Binding History}"
                         SelectedItem="{Binding SelectedEntry}"
                         ItemContainerStyle="{DynamicResource ListBoxItemStyle}"
                         Background="Transparent"
                         BorderThickness="0"
                         DisplayMemberPath="FileName"/>
            </Border>

            <TextBlock Grid.Row="1"
                       Text="{Binding StatusText}"
                       Foreground="{DynamicResource FgSecondaryBrush}"
                       FontSize="12"
                       Margin="0,6,0,0"/>
        </Grid>
    </Grid>
</UserControl>