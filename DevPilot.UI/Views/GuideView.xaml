<UserControl x:Class="DevPilot.UI.Views.GuideView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="Step" TargetType="TextBlock" BasedOn="{StaticResource Body}">
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,4,32,32" MaxWidth="760" HorizontalAlignment="Left">
            <TextBlock Text="Guide" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="How DevPilot is meant to be used, in five minutes." Style="{StaticResource PageSubtitle}"/>

            <Border Style="{StaticResource Card}" Margin="0,20,0,12">
                <StackPanel>
                    <TextBlock Text="1. One icon in the tray" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Style="{StaticResource Step}" Text="Click the DevPilot icon to open the hub. Every tool you add lives there, under groups you define. Hover a tool to see its options (what used to be in its own tray menu); click it to start it."/>
                    <TextBlock Style="{StaticResource Step}" Text="Right-click opens a short quick menu, double-click opens this window. You can change all three in Appearance."/>
                    <TextBlock Style="{StaticResource Step}" Text="Ctrl+Alt+Space opens the hub from anywhere (Settings → Global shortcuts)."/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="2. Add your tools" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Style="{StaticResource Step}" Text="Tools &amp; groups → Add. Pick one of your known tools (ScreenPilot, FocusPilot, NexusX, regTester, AutoPilot DC) and DevPilot fills in its options, process detection and autostart arguments. Anything else: a program, a script, a folder or a link."/>
                    <TextBlock Style="{StaticResource Step}" Text="Folders can show their content when you hover them (nested sub-folders, filters, limits)."/>
                    <TextBlock Style="{StaticResource Step}" Text="Choose per tool whether it stays only in the hub, gets a separate DevPilot icon, or keeps its own tray icon."/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="3. One owner for keep-awake and autostart" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Style="{StaticResource Step}" Text="Turn keep-awake on here, not in each tool. DevPilot starts managed tools with DEVPILOT_MANAGED=1 and DEVPILOT_SUPPRESS=tray,keepawake,autostart so tools that read it switch off their own versions."/>
                    <TextBlock Style="{StaticResource Step}" Text="Startup &amp; conflicts finds tools that still start with Windows on their own; Take over removes their entry (with a backup) and lets DevPilot start them, in the order and delay you choose."/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="4. Make it yours" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Style="{StaticResource Step}" Text="Appearance: theme, accent colour, hub width and height, corners, opacity, density, text size, position, flyout side, hover delay, group title style, and the ScreenPilot spotlight card."/>
                    <TextBlock Style="{StaticResource Step}" Text="Per tool: symbol, colour marker, bold, italic. Per group: title, symbol, colour dot, collapsed."/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
