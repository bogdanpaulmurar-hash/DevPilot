<UserControl x:Class="DevPilot.UI.Views.OverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hub="clr-namespace:DevPilot.UI.Hub">
    <UserControl.Resources>
        <Style x:Key="CardIconButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="StatCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Margin" Value="0,0,12,0"/>
            <Setter Property="Padding" Value="16,12"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,4,32,32">
            <Grid>
                <StackPanel>
                    <TextBlock Text="Overview" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="Everything DevPilot manages, grouped the way you arranged it. Hover the ⋯ button for a tool's options." Style="{StaticResource PageSubtitle}"/>
                </StackPanel>
                <Button HorizontalAlignment="Right" VerticalAlignment="Top" Command="{Binding OpenHubCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xF0E2;" Style="{StaticResource Glyph}" Margin="0,0,8,0"/>
                        <TextBlock Text="Open the hub"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Stats -->
            <UniformGrid Rows="1" Margin="0,20,-12,12">
                <Border Style="{StaticResource StatCard}">
                    <StackPanel>
                        <TextBlock Text="TOOLS" Style="{StaticResource Overline}"/>
                        <TextBlock Text="{Binding ToolCountText}" FontSize="15" FontWeight="SemiBold" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatCard}">
                    <StackPanel>
                        <TextBlock Text="RUNNING" Style="{StaticResource Overline}"/>
                        <TextBlock Text="{Binding RunningText}" FontSize="15" FontWeight="SemiBold" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatCard}">
                    <StackPanel>
                        <TextBlock Text="KEEP-AWAKE" Style="{StaticResource Overline}"/>
                        <TextBlock Text="{Binding KeepAwakeText}" FontSize="13" FontWeight="SemiBold" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Conflict banner -->
            <Border Style="{StaticResource Card}" BorderBrush="{DynamicResource AccentBrush}" Background="{DynamicResource AccentSoftBrush}"
                    Visibility="{Binding HasConflicts, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#xE7BA;" Style="{StaticResource Glyph}" Foreground="{DynamicResource AccentBrush}" Margin="0,0,10,0"/>
                        <TextBlock Text="{Binding ConflictText}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button HorizontalAlignment="Right" Content="Review" Style="{StaticResource AccentButton}" Command="{Binding OpenStartupCommand}"/>
                </Grid>
            </Border>

            <!-- Spotlight -->
            <Border Style="{StaticResource Card}" BorderBrush="{DynamicResource SpotlightBrush}" Background="{DynamicResource SpotlightSoftBrush}"
                    DataContext="{Binding Hub.Spotlight}" Visibility="{Binding Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="40" Height="40" CornerRadius="10" Background="{DynamicResource SpotlightBrush}">
                        <TextBlock Text="{Binding Tool.Glyph}" Style="{StaticResource Glyph}" FontSize="19" Foreground="{DynamicResource SpotlightForegroundBrush}"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Tool.Name}" FontSize="15" FontWeight="SemiBold"/>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Margin="0,1,6,0" Fill="{Binding Tool.State, Converter={StaticResource RunStateBrush}}"/>
                            <TextBlock Text="{Binding Tool.StatusText}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <ItemsControl ItemsSource="{Binding Featured}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type hub:SpotlightActionVM}">
                                    <Button Command="{Binding Command}" Margin="0,0,6,0" ToolTip="{Binding Label}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Glyph}" Style="{StaticResource Glyph}" Margin="0,0,6,0" Foreground="{DynamicResource TextBrush}"/>
                                            <TextBlock Text="{Binding Label}"/>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Style="{StaticResource IconButton}" Content="&#xE712;" Click="SpotlightMore_Click" ToolTip="All options"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Groups -->
            <ItemsControl ItemsSource="{Binding Hub.Groups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type hub:HubGroupVM}">
                        <StackPanel Margin="0,8,0,8">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Ellipse Width="7" Height="7" Margin="0,0,8,0" Fill="{Binding Color, Converter={StaticResource HexToBrush}}"
                                         Visibility="{Binding HasColor, Converter={StaticResource BoolToVis}}"/>
                                <TextBlock Text="{Binding Model.Title}" Style="{StaticResource SectionTitle}" Margin="0"/>
                                <TextBlock Text="{Binding Tools.Count}" Style="{StaticResource Hint}" Margin="8,1,0,0"/>
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding Tools}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type hub:HubToolVM}">
                                        <Border Style="{StaticResource Card}" Width="262" Margin="0,0,12,12" Padding="14,12">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource Surface2Brush}"
                                                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                                        <Grid>
                                                            <TextBlock Text="{Binding Glyph}" Style="{StaticResource Glyph}" FontSize="15" Foreground="{DynamicResource TextBrush}"/>
                                                            <Border Width="3" Height="14" CornerRadius="1.5" HorizontalAlignment="Left" Margin="-1,0,0,0"
                                                                    Background="{Binding Color, Converter={StaticResource HexToBrush}}"
                                                                    Visibility="{Binding HasColor, Converter={StaticResource BoolToVis}}"/>
                                                        </Grid>
                                                    </Border>
                                                    <TextBlock Grid.Column="1" Text="{Binding Name}" Margin="10,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                               FontWeight="{Binding Bold, Converter={StaticResource BoolToWeight}}"
                                                               FontStyle="{Binding Italic, Converter={StaticResource BoolToStyle}}"/>
                                                    <Ellipse Grid.Column="2" Width="8" Height="8" VerticalAlignment="Center" ToolTip="{Binding StatusText}"
                                                             Fill="{Binding State, Converter={StaticResource RunStateBrush}}"/>
                                                </Grid>
                                                <TextBlock Grid.Row="1" Text="{Binding Description}" Style="{StaticResource Hint}" Margin="0,8,0,0"
                                                           MaxHeight="34" TextTrimming="CharacterEllipsis"/>
                                                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="-4,10,0,0">
                                                    <Button Style="{StaticResource CardIconButton}" Content="&#xE768;" ToolTip="Start / open"
                                                            Command="{Binding DataContext.StartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                                    <Button Style="{StaticResource CardIconButton}" Content="&#xE72C;" ToolTip="Restart"
                                                            Command="{Binding DataContext.RestartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                                    <Button Style="{StaticResource CardIconButton}" Content="&#xE71A;" ToolTip="Stop"
                                                            Command="{Binding DataContext.StopCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                                    <Button Style="{StaticResource CardIconButton}" Content="&#xE712;" ToolTip="Options" Click="More_Click"/>
                                                    <Button Style="{StaticResource CardIconButton}" Content="&#xE70F;" ToolTip="Edit"
                                                            Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel Margin="0,40" HorizontalAlignment="Center" Visibility="{Binding Hub.IsEmpty, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="No tools yet" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                <TextBlock Text="Add your apps, scripts and folders — or pick one of your known tools (ScreenPilot, FocusPilot, NexusX, regTester, AutoPilot DC)."
                           Style="{StaticResource Hint}" TextAlignment="Center" MaxWidth="420"/>
                <Button Content="Add tools" Style="{StaticResource AccentButton}" Command="{Binding AddToolsCommand}" HorizontalAlignment="Center" Margin="0,12,0,0"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
