<Window x:Class="DevPilot.UI.Views.Dialogs.InputBoxDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Change Hotkey"
        Width="430" Height="180"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource BgSurfaceBrush}">

    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Prompt label -->
        <TextBlock Grid.Row="0"
                   x:Name="TxtPrompt"
                   Foreground="{DynamicResource FgPrimaryBrush}"
                   FontSize="13" TextWrapping="Wrap"/>

        <!-- Input box -->
        <TextBox Grid.Row="2"
                 x:Name="TxtInput"
                 Style="{DynamicResource InputStyle}"
                 Height="34"/>

        <!-- Format hint -->
        <TextBlock Grid.Row="3"
                   Text="Format: Ctrl+Shift+X  (e.g. Ctrl+Alt+P)"
                   FontSize="11"
                   Foreground="{DynamicResource FgMutedBrush}"
                   Margin="2,4,0,0"/>

        <!-- Buttons -->
        <StackPanel Grid.Row="5"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="OK"
                    Width="80" Height="30"
                    IsDefault="True"
                    Style="{DynamicResource PrimaryButtonStyle}"
                    Margin="0,0,8,0"
                    Click="OnOk"/>
            <Button Content="Cancel"
                    Width="80" Height="30"
                    IsCancel="True"
                    Style="{DynamicResource SecondaryButtonStyle}"
                    Click="OnCancel"/>
        </StackPanel>
    </Grid>
</Window>