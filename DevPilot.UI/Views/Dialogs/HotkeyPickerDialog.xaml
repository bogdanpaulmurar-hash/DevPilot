<Window x:Class="DevPilot.UI.Views.Dialogs.HotkeyPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="🎹  Change Hotkey"
        Width="420" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource BgMainBrush}">

    <StackPanel Margin="24,20,24,24">

        <!-- Action label -->
        <TextBlock x:Name="TxtActionLabel"
                   FontSize="13" FontWeight="SemiBold"
                   Foreground="{DynamicResource FgPrimaryBrush}"
                   Margin="0,0,0,18" TextWrapping="Wrap"/>

        <!-- Modifier keys -->
        <TextBlock Text="Modifier keys  (at least one required)"
                   FontSize="11"
                   Foreground="{DynamicResource FgSecondaryBrush}"
                   Margin="0,0,0,8"/>
        <WrapPanel Margin="0,0,0,18">
            <CheckBox x:Name="ChkCtrl"  Content="Ctrl"
                      Style="{DynamicResource CheckStyle}"
                      Margin="0,0,18,0"
                      Checked="OnModifierChanged" Unchecked="OnModifierChanged"/>
            <CheckBox x:Name="ChkAlt"   Content="Alt"
                      Style="{DynamicResource CheckStyle}"
                      Margin="0,0,18,0"
                      Checked="OnModifierChanged" Unchecked="OnModifierChanged"/>
            <CheckBox x:Name="ChkShift" Content="Shift"
                      Style="{DynamicResource CheckStyle}"
                      Margin="0,0,18,0"
                      Checked="OnModifierChanged" Unchecked="OnModifierChanged"/>
            <CheckBox x:Name="ChkWin"   Content="Win"
                      Style="{DynamicResource CheckStyle}"
                      Checked="OnModifierChanged" Unchecked="OnModifierChanged"/>
        </WrapPanel>

        <!-- Key selection -->
        <TextBlock Text="Key"
                   FontSize="11"
                   Foreground="{DynamicResource FgSecondaryBrush}"
                   Margin="0,0,0,8"/>
        <ComboBox x:Name="CmbKey"
                  Style="{DynamicResource ComboStyle}"
                  Height="34" Margin="0,0,0,18"
                  SelectionChanged="OnKeyChanged"/>

        <!-- Preview box -->
        <Border Background="{DynamicResource BgCardBrush}"
                CornerRadius="6" Padding="14,10" Margin="0,0,0,6">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Preview: "
                           Foreground="{DynamicResource FgSecondaryBrush}"
                           FontSize="13" VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtPreview"
                           Foreground="{DynamicResource AccentBrush}"
                           FontFamily="Consolas" FontSize="15" FontWeight="Bold"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Warning: no modifier -->
        <TextBlock x:Name="TxtWarning"
                   Text="⚠  At least one modifier key (Ctrl, Alt, Shift, Win) is required."
                   Foreground="#E07B39"
                   FontSize="11" TextWrapping="Wrap"
                   Visibility="Collapsed"
                   Margin="0,4,0,0"/>

        <!-- Buttons -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Cancel" Width="90" Height="32"
                    Style="{DynamicResource SecondaryButtonStyle}"
                    Margin="0,0,10,0"
                    IsCancel="True"
                    Click="OnCancel"/>
            <Button x:Name="BtnApply" Content="✔  Apply" Width="100" Height="32"
                    Style="{DynamicResource PrimaryButtonStyle}"
                    IsDefault="True"
                    Click="OnApply"/>
        </StackPanel>

    </StackPanel>
</Window>