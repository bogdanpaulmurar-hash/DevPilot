<Window x:Class="DevPilot.UI.Views.Dialogs.AnnotationEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DevPilot — Annotation Editor"
        Height="680" Width="1000"
        MinHeight="400" MinWidth="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgMainBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <StackPanel Grid.Row="0" Orientation="Horizontal"
                    Background="{DynamicResource BgCardBrush}"
                    Margin="0,0,0,4">

            <ToggleButton x:Name="BtnRect"    Content="▭ Rect"
                          IsChecked="True"    Margin="6,4" Padding="8,4"
                          Checked="OnToolChanged" Unchecked="OnToolChanged"
                          Foreground="{DynamicResource FgOnAccentBrush}"
                          Background="{DynamicResource AccentBrush}"/>
            <ToggleButton x:Name="BtnArrow"   Content="➜ Arrow"
                          Margin="4,4"        Padding="8,4"
                          Checked="OnToolChanged" Unchecked="OnToolChanged"
                          Foreground="{DynamicResource FgPrimaryBrush}"
                          Background="{DynamicResource BgSurfaceBrush}"/>
            <ToggleButton x:Name="BtnText"    Content="T Text"
                          Margin="4,4"        Padding="8,4"
                          Checked="OnToolChanged" Unchecked="OnToolChanged"
                          Foreground="{DynamicResource FgPrimaryBrush}"
                          Background="{DynamicResource BgSurfaceBrush}"/>

            <Separator Width="1"
                       Background="{DynamicResource SeparatorBrush}"
                       Margin="8,4"/>

            <TextBlock Text="Color:"
                       Foreground="{DynamicResource FgPrimaryBrush}"
                       VerticalAlignment="Center" Margin="4,0"/>
            <Border x:Name="ColorPreview"
                    Width="28" Height="28" CornerRadius="4"
                    Background="Red" Cursor="Hand"
                    MouseLeftButtonDown="OnPickColor"
                    Margin="4,4"/>

            <TextBlock Text="Thickness:"
                       Foreground="{DynamicResource FgPrimaryBrush}"
                       VerticalAlignment="Center" Margin="8,0,4,0"/>
            <Slider x:Name="ThicknessSlider"
                    Minimum="1" Maximum="10" Value="2"
                    Width="80" VerticalAlignment="Center"/>

            <Separator Width="1"
                       Background="{DynamicResource SeparatorBrush}"
                       Margin="8,4"/>

            <Button Content="↩ Undo"   Click="OnUndo"
                    Margin="4,4" Padding="8,4"
                    Background="{DynamicResource BgSurfaceBrush}"
                    Foreground="{DynamicResource FgPrimaryBrush}"
                    BorderThickness="0"/>
            <Button Content="🗑 Clear"  Click="OnClear"
                    Margin="4,4" Padding="8,4"
                    Background="{DynamicResource BgSurfaceBrush}"
                    Foreground="{DynamicResource FgPrimaryBrush}"
                    BorderThickness="0"/>

            <Separator Width="1"
                       Background="{DynamicResource SeparatorBrush}"
                       Margin="8,4"/>

            <Button Content="💾 Save"   Click="OnSave"
                    Margin="4,4" Padding="8,4"
                    Background="{DynamicResource AccentBrush}"
                    Foreground="{DynamicResource FgOnAccentBrush}"
                    BorderThickness="0"/>
            <Button Content="📋 Copy"   Click="OnCopyClipboard"
                    Margin="4,4" Padding="8,4"
                    Background="{DynamicResource BgSurfaceBrush}"
                    Foreground="{DynamicResource FgPrimaryBrush}"
                    BorderThickness="0"/>
        </StackPanel>

        <!-- Canvas area -->
        <ScrollViewer Grid.Row="1"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      Background="{DynamicResource BgInputBrush}">
            <Grid>
                <!-- Base image -->
                <Image x:Name="BaseImage" Stretch="None"
                       HorizontalAlignment="Left" VerticalAlignment="Top"/>
                <!-- Annotation canvas -->
                <Canvas x:Name="AnnotationCanvas"
                        Background="Transparent"
                        MouseLeftButtonDown="Canvas_MouseDown"
                        MouseMove="Canvas_MouseMove"
                        MouseLeftButtonUp="Canvas_MouseUp"
                        Cursor="Cross"/>
            </Grid>
        </ScrollViewer>

        <!-- Status bar -->
        <Border Grid.Row="2"
                Background="{DynamicResource BgCardBrush}"
                Padding="8,4">
            <TextBlock x:Name="StatusLabel"
                       Text="Selecteaza un tool si deseneaza pe imagine."
                       Foreground="{DynamicResource FgMutedBrush}"
                       FontSize="12"/>
        </Border>
    </Grid>
</Window>
