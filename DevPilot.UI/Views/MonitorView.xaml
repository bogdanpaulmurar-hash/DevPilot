<UserControl x:Class="DevPilot.UI.Views.MonitorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DevPilot.UI.ViewModels"
             xmlns:svc="clr-namespace:DevPilot.UI.Services"
             xmlns:core="clr-namespace:DevPilot.Core.Interfaces;assembly=DevPilot.Core">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,4,32,32" MaxWidth="900" HorizontalAlignment="Left">
            <Grid>
                <StackPanel>
                    <TextBlock Text="Monitor" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="Live status of your tools. Auto-restart reports the real state and stops after the hourly limit." Style="{StaticResource PageSubtitle}"/>
                </StackPanel>
                <Button Content="Refresh" HorizontalAlignment="Right" VerticalAlignment="Top" Command="{Binding RefreshCommand}"/>
            </Grid>

            <Border Style="{StaticResource Card}" Margin="0,20,0,12" svc:EditTracker.Area="{x:Static core:ConfigArea.Tools}">
                <StackPanel>
                    <TextBlock Text="Tools" Style="{StaticResource SectionTitle}"/>
                    <ItemsControl ItemsSource="{Binding Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:MonitorRowVM}">
                                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="20"/>
                                            <ColumnDefinition Width="28"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Width="8" Height="8" Fill="{Binding State, Converter={StaticResource RunStateBrush}}" HorizontalAlignment="Left"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Glyph}" Style="{StaticResource Glyph}" HorizontalAlignment="Left" TextAlignment="Left"/>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Hint}" Margin="0,1,0,0"/>
                                            <TextBlock Text="{Binding Match, StringFormat='matching: {0}'}" Style="{StaticResource Hint}" FontFamily="{StaticResource MonoFont}" Margin="0,1,0,0"/>
                                        </StackPanel>
                                        <CheckBox Grid.Column="3" Content="Auto-restart" IsChecked="{Binding Tool.Monitor.AutoRestart}" VerticalAlignment="Center" Margin="12,0"/>
                                        <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Style="{StaticResource IconButton}" Content="&#xE768;" ToolTip="Start"
                                                    Command="{Binding DataContext.StartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                            <Button Style="{StaticResource IconButton}" Content="&#xE72C;" ToolTip="Restart"
                                                    Command="{Binding DataContext.RestartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                            <Button Style="{StaticResource IconButton}" Content="&#xE71A;" ToolTip="Stop"
                                                    Command="{Binding DataContext.StopCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="No tools with a recognisable process yet." Style="{StaticResource Hint}" Visibility="{Binding Rows.Count, Converter={StaticResource BoolToVisInv}}"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" svc:EditTracker.Area="{x:Static core:ConfigArea.Monitor}">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="Other checks (processes or URLs)" Style="{StaticResource SectionTitle}"/>
                        <Button Content="Add check" HorizontalAlignment="Right" Command="{Binding AddTargetCommand}"/>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Targets}" Margin="0,6,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:HealthRowVM}">
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Width="8" Height="8" Fill="{Binding State, Converter={StaticResource RunStateBrush}}" HorizontalAlignment="Left" ToolTip="{Binding Detail}"/>
                                    <TextBox Grid.Column="1" Text="{Binding Model.Name, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBox Grid.Column="3" Text="{Binding Model.Target, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource MonoFont}" FontSize="12"/>
                                    <CheckBox Grid.Column="4" Content="URL" IsChecked="{Binding Model.IsUrl}" Margin="10,0" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="5" Text="{Binding Detail}" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0"/>
                                    <Button Grid.Column="6" Style="{StaticResource IconButton}" Content="&#xE74D;"
                                            Command="{Binding DataContext.RemoveTargetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="Check every" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox Text="{Binding Settings.IntervalSeconds, UpdateSourceTrigger=PropertyChanged}" Width="50"/>
                        <TextBlock Text="seconds" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
