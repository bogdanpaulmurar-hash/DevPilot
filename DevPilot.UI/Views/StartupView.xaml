<UserControl x:Class="DevPilot.UI.Views.StartupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DevPilot.UI.ViewModels"
             xmlns:models="clr-namespace:DevPilot.Models;assembly=DevPilot.Models"
             xmlns:svc="clr-namespace:DevPilot.UI.Services"
             xmlns:core="clr-namespace:DevPilot.Core.Interfaces;assembly=DevPilot.Core">
    <ScrollViewer VerticalScrollBarVisibility="Auto" svc:EditTracker.Area="{x:Static core:ConfigArea.Startup}">
        <StackPanel Margin="32,4,32,32" MaxWidth="900" HorizontalAlignment="Left">
            <TextBlock Text="Startup &amp; conflicts" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="DevPilot is the only thing that starts with Windows. It removes the autostart entries of the tools it manages (with a backup you can restore) and starts those tools itself."
                       Style="{StaticResource PageSubtitle}"/>

            <Border Style="{StaticResource Card}" Margin="0,20,0,12">
                <StackPanel>
                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding StartWithWindows}">
                        <StackPanel>
                            <TextBlock Text="Start DevPilot with Windows" FontWeight="SemiBold"/>
                            <TextBlock Text="Registers DevPilot for your user (no administrator rights needed)." Style="{StaticResource Hint}" Margin="0,1,0,0"/>
                        </StackPanel>
                    </CheckBox>
                    <CheckBox Style="{StaticResource Switch}" Content="When started with Windows, stay in the tray" IsChecked="{Binding Settings.StartHidden}" Margin="0,10,0,0"/>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBlock Text="Re-check every" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox Text="{Binding Settings.RecheckMinutes, UpdateSourceTrigger=PropertyChanged}" Width="50"/>
                        <TextBlock Text="minutes that tools did not register themselves again (0 = only at start)" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="Autostart entries on this PC" Style="{StaticResource SectionTitle}"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Take over all" Style="{StaticResource AccentButton}" Margin="0,0,6,0" Command="{Binding TakeOverAllCommand}"
                                    Visibility="{Binding HasConflicts, Converter={StaticResource BoolToVis}}"/>
                            <Button Content="Scan again" Command="{Binding RefreshCommand}"/>
                        </StackPanel>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Entries}" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:StartupEntryVM}">
                                <Border x:Name="Row" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Location}" Style="{StaticResource Hint}" Margin="10,0,0,0"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Command}" Style="{StaticResource Hint}" FontFamily="{StaticResource MonoFont}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                            <TextBlock Text="{Binding MatchText}" FontSize="12" Foreground="{DynamicResource AccentBrush}" Margin="0,2,0,0"
                                                       Visibility="{Binding IsManagedTool, Converter={StaticResource BoolToVis}}"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="Take over" VerticalAlignment="Center" Margin="12,0,0,0" Command="{Binding TakeOverCommand}"
                                                Visibility="{Binding CanTakeOver, Converter={StaticResource BoolToVis}}"/>
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsManagedTool}" Value="False">
                                        <Setter TargetName="Row" Property="Opacity" Value="0.6"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="Entries of other programs are only listed; DevPilot changes only the ones that belong to tools it manages." Style="{StaticResource Hint}"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Taken over (backed up)" Style="{StaticResource SectionTitle}"/>
                    <ItemsControl ItemsSource="{Binding TakenOver}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:TakeoverVM}">
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Hint}"/>
                                        <TextBlock Text="{Binding Command}" Style="{StaticResource Hint}" FontFamily="{StaticResource MonoFont}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Restore" VerticalAlignment="Center" Command="{Binding RestoreCommand}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="Nothing taken over yet." Style="{StaticResource Hint}" Visibility="{Binding TakenOver.Count, Converter={StaticResource BoolToVisInv}}"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Started by DevPilot" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="{Binding AutoStartStatusText}" Style="{StaticResource Hint}" Margin="0,0,0,6"
                               Visibility="{Binding HasAutoStartStatus, Converter={StaticResource BoolToVis}}"/>
                    <ItemsControl ItemsSource="{Binding AutoStartTools}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:ToolEntry}">
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}"/>
                                    <TextBlock Grid.Column="1" Style="{StaticResource Hint}" Margin="0">
                                        <Run Text="order"/> <Run Text="{Binding AutoStart.Order, Mode=OneWay}"/> <Run Text="· after"/> <Run Text="{Binding AutoStart.DelaySeconds, Mode=OneWay}"/> <Run Text="s"/>
                                    </TextBlock>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="Turn on &quot;Start with DevPilot&quot; for a tool in Tools &amp; groups (taking over an entry does it for you)." Style="{StaticResource Hint}"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
