<UserControl x:Class="DevPilot.UI.Views.ColorField"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DevPilot.UI.ViewModels"
             xmlns:svc="clr-namespace:DevPilot.UI.Services"
             x:Name="Root">
    <!-- Palette swatches, a hex box and "None". Empty value = theme colour. -->
    <StackPanel Orientation="Horizontal">
        <ItemsControl ItemsSource="{x:Static vm:ToolEditorVM.Palette}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Width="22" Height="22" MinHeight="0" Padding="0" Margin="0,0,5,0" ToolTip="{Binding}" BorderThickness="0"
                            Background="{Binding Converter={StaticResource HexToBrush}}"
                            Click="Swatch_Click" Tag="{Binding}"/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBox x:Name="HexBox" Width="90" Margin="6,0,0,0" FontFamily="{StaticResource MonoFont}" FontSize="12" svc:EditTracker.NoTrack="True"
                 Text="{Binding Value, ElementName=Root, UpdateSourceTrigger=LostFocus}"/>
        <Button Content="None" Margin="6,0,0,0" Click="None_Click"/>
    </StackPanel>
</UserControl>
