<Window x:Class="DevPilot.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:DevPilot.UI.Views"
        Title="DevPilot — IT Automation Hub"
        Height="720" Width="1150"
        MinHeight="500" MinWidth="800"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ── Header ───────────────────────────────────────────────────── -->
        <Border Grid.Row="0"
                BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource BorderBrush}"
                Background="{DynamicResource BgSurfaceBrush}"
                Padding="16,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="DevPilot"
                           FontSize="18" FontWeight="Bold"
                           Foreground="{DynamicResource AccentBrush}"
                           VerticalAlignment="Center"/>
                <TextBlock Text=" — IT Automation Hub"
                           FontSize="14"
                           Foreground="{DynamicResource FgMutedBrush}"
                           VerticalAlignment="Center"
                           Margin="4,0,0,0"/>
                <Button Content="Toggle Theme"
                        Click="OnThemeToggle"
                        Width="110" Height="28"
                        Margin="20,0,0,0"
                        Style="{DynamicResource SecondaryButtonStyle}"/>
            </StackPanel>
        </Border>

        <!-- ── Tab content ──────────────────────────────────────────────── -->
        <TabControl Grid.Row="1"
                    Background="{DynamicResource BgMainBrush}"
                    BorderThickness="0"
                    Padding="0">

            <!-- Launcher — always visible -->
            <TabItem Header="Launcher">
                <views:AppLauncherView x:Name="AppLauncherViewControl"/>
            </TabItem>

            <!-- Tools -->
            <TabItem Header="Tools"
                     Visibility="{Binding SettingsViewModel.ToolsTabVisibility}">
                <views:ExternalToolsView x:Name="ExternalToolsViewControl"/>
            </TabItem>

            <!-- Jiggler -->
            <TabItem Header="Jiggler"
                     Visibility="{Binding SettingsViewModel.JigglerTabVisibility}">
                <views:JigglerView x:Name="JigglerViewControl"/>
            </TabItem>

            <!-- Screenshot -->
            <TabItem Header="Screenshot"
                     Visibility="{Binding SettingsViewModel.ScreenshotTabVisibility}">
                <views:ScreenshotView x:Name="ScreenshotViewControl"/>
            </TabItem>

            <!-- Heartbeat -->
            <TabItem Header="Heartbeat"
                     Visibility="{Binding SettingsViewModel.HeartbeatTabVisibility}">
                <views:HeartbeatView x:Name="HeartbeatViewControl"/>
            </TabItem>

            <!-- Guide — always visible, no ViewModel, read-only content -->
            <TabItem Header="Guide">
                <views:GuideView x:Name="GuideViewControl"/>
            </TabItem>

            <!-- Settings — always visible -->
            <TabItem Header="Settings">
                <views:SettingsView x:Name="SettingsViewControl"/>
            </TabItem>

        </TabControl>

        <!-- ── Status bar ───────────────────────────────────────────────── -->
        <StatusBar Grid.Row="2"
                   Background="{DynamicResource BgSurfaceBrush}">
            <StatusBarItem>
                <TextBlock x:Name="TxtStatus"
                           Text="Ready"
                           Foreground="{DynamicResource FgMutedBrush}"
                           FontSize="11"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
