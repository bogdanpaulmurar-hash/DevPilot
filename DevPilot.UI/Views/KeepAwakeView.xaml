<UserControl x:Class="DevPilot.UI.Views.KeepAwakeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DevPilot.UI.ViewModels"
             xmlns:svc="clr-namespace:DevPilot.UI.Services"
             xmlns:core="clr-namespace:DevPilot.Core.Interfaces;assembly=DevPilot.Core">
    <ScrollViewer VerticalScrollBarVisibility="Auto" svc:EditTracker.Area="{x:Static core:ConfigArea.KeepAwake}">
        <StackPanel Margin="32,4,32,32" MaxWidth="820" HorizontalAlignment="Left">
            <TextBlock Text="Keep-awake" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="One keep-awake for everything. Managed tools are asked to switch off their own mouse movers, so nothing runs twice." Style="{StaticResource PageSubtitle}"/>

            <Border Style="{StaticResource Card}" Margin="0,20,0,12">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="Keep this PC awake" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Status}" Style="{StaticResource Hint}"/>
                    </StackPanel>
                    <CheckBox Style="{StaticResource Switch}" HorizontalAlignment="Right" IsChecked="{Binding Enabled}"/>
                </Grid>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Method" Style="{StaticResource SectionTitle}"/>
                    <RadioButton GroupName="mode" IsChecked="{Binding Settings.Mode, Converter={StaticResource EnumEquals}, ConverterParameter=Silent}">
                        <StackPanel>
                            <TextBlock Text="Silent (recommended)"/>
                            <TextBlock Text="Tells Windows not to sleep or lock the screen. Nothing moves, nothing is typed." Style="{StaticResource Hint}" Margin="0,1,0,0"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton GroupName="mode" Margin="0,8,0,0" IsChecked="{Binding Settings.Mode, Converter={StaticResource EnumEquals}, ConverterParameter=MouseNudge}">
                        <StackPanel>
                            <TextBlock Text="Mouse nudge"/>
                            <TextBlock Text="Also sends a 1-pixel move and back when you are idle — for apps that show you as away (chat status)." Style="{StaticResource Hint}" Margin="0,1,0,0"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton GroupName="mode" Margin="0,8,0,0" IsChecked="{Binding Settings.Mode, Converter={StaticResource EnumEquals}, ConverterParameter=F15Key}">
                        <StackPanel>
                            <TextBlock Text="F15 key"/>
                            <TextBlock Text="Sends the F15 key when idle (a key that ordinary apps ignore)." Style="{StaticResource Hint}" Margin="0,1,0,0"/>
                        </StackPanel>
                    </RadioButton>
                    <CheckBox Content="Keep the display on as well" IsChecked="{Binding Settings.KeepDisplayOn}" Margin="0,12,0,0"/>
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding Settings.IntervalSeconds, StringFormat='Nudge every {0} s'}" Style="{StaticResource FieldLabel}"/>
                            <Slider Minimum="10" Maximum="600" SmallChange="10" LargeChange="30" Value="{Binding Settings.IntervalSeconds}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{Binding Settings.OnlyWhenIdleSeconds, StringFormat='Only after {0} s without input'}" Style="{StaticResource FieldLabel}"/>
                            <Slider Minimum="0" Maximum="600" SmallChange="10" LargeChange="30" Value="{Binding Settings.OnlyWhenIdleSeconds}"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Schedule" Style="{StaticResource SectionTitle}"/>
                    <CheckBox Style="{StaticResource Switch}" Content="Only during working hours" IsChecked="{Binding Settings.ScheduleEnabled}"/>
                    <StackPanel IsEnabled="{Binding Settings.ScheduleEnabled}" Margin="0,8,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="From" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox Text="{Binding Settings.ScheduleFrom, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
                            <TextBlock Text="to" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="12,0,8,0"/>
                            <TextBox Text="{Binding Settings.ScheduleTo, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding Days}" Margin="0,10,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:DayToggleVM}">
                                    <ToggleButton Style="{StaticResource DayToggle}" Content="{Binding Label}" IsChecked="{Binding IsOn}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="Overnight windows work too (e.g. 22:00 to 06:00)." Style="{StaticResource Hint}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Tools with their own keep-awake" Style="{StaticResource SectionTitle}"/>
                    <ItemsControl ItemsSource="{Binding Overlaps}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:OverlapInfo}">
                                <StackPanel Margin="0,0,0,10">
                                    <TextBlock Text="{Binding Tool}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Text}" Style="{StaticResource Hint}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="None of your tools has its own keep-awake." Style="{StaticResource Hint}"
                               Visibility="{Binding Overlaps.Count, Converter={StaticResource BoolToVisInv}}"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
