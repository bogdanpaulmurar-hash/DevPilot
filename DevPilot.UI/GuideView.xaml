<!-- ============================================================
     DevPilot — IT Automation Hub v1.0
     GuideView.xaml — User Guide and Quick Reference tab
     Phase: 10 (New)
     Author: Bogdan Murar (Z003FU5C) — Siemens AG
     ============================================================ -->
<UserControl x:Class="DevPilot.UI.Views.GuideView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource BgMainBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,20,24,32" MaxWidth="860">

            <!-- ── Page title ────────────────────────────────────────────── -->
            <TextBlock Text="&#x1F4D6;  User Guide &amp; Quick Reference"
                       FontSize="20" FontWeight="Bold"
                       Foreground="{DynamicResource AccentBrush}"
                       Margin="0,0,0,4"/>
            <TextBlock Foreground="{DynamicResource FgSecondaryBrush}" FontSize="12"
                       Text="DevPilot — IT Automation Hub v1.0  |  Bogdan Murar (Z003FU5C) — Siemens AG"
                       Margin="0,0,0,6"/>
            <TextBlock Foreground="{DynamicResource FgSecondaryBrush}" FontSize="11"
                       TextWrapping="Wrap"
                       Text="This tab explains every feature. Refer here whenever you are unsure how something works."
                       Margin="0,0,0,24"/>

            <!-- ══════════════════════════════════════════════════════════
                 HOTKEYS
            ══════════════════════════════════════════════════════════ -->
            <Border Style="{DynamicResource CardStyle}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="&#x2328;  Global Keyboard Shortcuts"
                               FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentBrush}"
                               Margin="0,0,0,10"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" FontFamily="Consolas" FontSize="13"
                                   Foreground="{DynamicResource AccentBrush}" Text="Ctrl + Shift + D" Margin="0,0,0,6"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" FontSize="12"
                                   Foreground="{DynamicResource FgSecondaryBrush}" Text="Show / Hide the DevPilot window" Margin="0,0,0,6"/>
                        <TextBlock Grid.Row="1" Grid.Column="0" FontFamily="Consolas" FontSize="13"
                                   Foreground="{DynamicResource AccentBrush}" Text="Ctrl + Shift + J" Margin="0,0,0,6"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" FontSize="12"
                                   Foreground="{DynamicResource FgSecondaryBrush}" Text="Toggle Mouse Jiggler on / off" Margin="0,0,0,6"/>
                        <TextBlock Grid.Row="2" Grid.Column="0" FontFamily="Consolas" FontSize="13"
                                   Foreground="{DynamicResource AccentBrush}" Text="Ctrl + Shift + S"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" FontSize="12"
                                   Foreground="{DynamicResource FgSecondaryBrush}" Text="Take a screenshot (full screen)"/>
                    </Grid>
                    <TextBlock FontSize="11" Foreground="{DynamicResource FgSecondaryBrush}"
                               Margin="0,8,0,0" TextWrapping="Wrap"
                               Text="Hotkeys work even when DevPilot is minimised to tray. You can change them in Settings &#x2192; Hotkeys."/>
                </StackPanel>
            </Border>

            <!-- ══════════════════════════════════════════════════════════
                 APP LAUNCHER
            ══════════════════════════════════════════════════════════ -->
            <Border Style="{DynamicResource CardStyle}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="&#x1F680;  App Launcher"
                               FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentBrush}"
                               Margin="0,0,0,8"/>
                    <TextBlock TextWrapping="Wrap" FontSize="12"
                               Foreground="{DynamicResource FgSecondaryBrush}" Margin="0,0,0,8"
                               Text="Central hub to launch any executable, folder, URL, PowerShell script, batch file, Python script, SSH session, or WSL command — all from one place."/>
                    <TextBlock FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource FgPrimaryBrush}" Margin="0,0,0,4"
                               Text="How to add an entry:"/>
                    <TextBlock TextWrapping="Wrap" FontSize="12"
                               Foreground="{DynamicResource FgSecondaryBrush}" Margin="8,0,0,8">
                        <Run>1. Click </Run><Run FontWeight="Bold">+ Add</Run><Run>.</Run><LineBreak/>
                        <Run>2. Enter a </Run><Run FontWeight="Bold">Name</Run><Run>, select the </Run>
                        <Run FontWeight="Bold">Type</Run><Run> (Executable, Folder, URL…), and set the </Run>
                        <Run FontWeight="Bold">Path / Target</Run><Run>.</Run><LineBreak/>
                        <Run>3. Click </Run><Run FontWeight="Bold">Save</Run><Run> in the dialog.</Run>
                    </TextBlock>
                    <TextBlock FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource FgPrimaryBrush}" Margin="0,0,0,4"
                               Text="How to launch:"/>
                    <TextBlock TextWrapping="Wrap" FontSize="12"
                               Foreground="{DynamicResource FgSecondaryBrush}" Margin="8,0,0,8">
                        <Run>&#x2022; Select a row, click </Run><Run FontWeight="Bold">&#x25B6; Launch</Run>
                        <Run> — OR — double-click any row to launch immediately.</Run><LineBreak/>
                        <Run>&#x2022; Use </Run><Run FontWeight="Bold">&#x25B2; / &#x25BC;</Run>
                        <Run> to reorder entries.</Run><LineBreak/>
                        <Run>&#x2022; Filter box (top): type to search by name.</Run>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- ══════════════════════════════════════════════════════════
                 EXTERNAL TOOLS
            ══════════════════════════════════════════════════════════ -->
            <Border Style="{DynamicResource CardStyle}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="&#x1F527;  External Tools  (Tools tab)"
                               FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentBrush}"
                               Margin="0,0,0,8"/>
                    <TextBlock TextWrapping="Wrap" FontSize="12"
                               Foreground="{DynamicResource FgSecondaryBrush}" Margin="0,0,0,8"
                               Text="Dedicated one-click launcher for 3 specific tools: DataCleansing Solution, TestClientUtilityApp, and TC Management Local Starter. DevPilot only starts the exe — it never modifies these tools."/>
                    <TextBlock TextWrapping="Wrap" FontSize="12"
                               Foreground="{DynamicResource FgSecondaryBrush}" Margin="8,0,0,0">
                        <Run FontWeight="Bold">Setup:</Run>
                        <Run> Go to </Run><Run FontWeight="Bold">Settings &#x2192; Executable Paths</Run>
                        <Run>, enter the correct .exe path for each tool, click </Run>
                        <Run FontWeight="Bold">Save Settings</Run><Run>.</Run><LineBreak/>
                        <Run FontWeight="Bold">Status:</Run>
                        <Run> Green &#x25CF; = running (shows PID) | Orange &#x26A0; = not found | Grey &#x25CF; = not started.</Run><LineBreak/>
                        <Run FontWeight="Bold">Monitoring:</Run>
                        <Run> DevPilot polls every 2 seconds and updates the status automatically when the process exits.</Run>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- ══════════════════════════════════════════════════════════
                 MOUSE JIGGLER
            ══════════════════════════════════════════════════════════ -->
            <Border Style="{DynamicResource CardStyle}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="&#x1F5B1;  Mouse Jiggler  (Jiggler tab)"
                               FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentBrush}"
                               Margin="0,0,0,8"/>
                    <TextBlock TextWrapping="Wrap" FontSize="12"
                               Foreground="{DynamicResource FgSecondaryBrush}" Margin="0,0,0,8"
                               Text="Prevents screen lock and session timeout by moving the mouse cursor &#xB1;1 pixel at a configurable interval. Works silently in the background."/>
                    <TextBlock TextWrapping="Wrap" FontSize="12"
                               Foreground="{DynamicResource FgSecondaryBrush}" Margin="8,0,0,0">
                        <Run FontWeight="Bold">1.</Run><Run> Set the </Run>
                        <Run FontWeight="Bold">interval</Run><Run> (10–300 seconds) and </Run>
                        <Run FontWeight="Bold">method</Run><Run> (Mouse Move or Key Press).</Run><LineBreak/>
                        <Run FontWeight="Bold">2.</Run><Run> Click </Run>
                        <Run FontWeight="Bold">Start Jiggler</Run><Run>  —or—  press </Run>
                        <Run FontFamily="Consolas" Foreground="{DynamicResource AccentBrush}">Ctrl+Shift+J</Run><Run>.</Run><LineBreak/>
                        <Run FontWeight="Bold">3.</Run><Run> Minimise DevPilot — jiggler continues running as long as DevPilot is in the tray.</Run><LineBreak/>
                        <Run FontWeight="Bold">Tray:</Run><Run> Right-click the tray icon &#x2192; Start / Stop Jiggler.</Run>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- ══════════════════════════════════════════════════════════
                 SCREENSHOT
            ══════════════════════════════════════════════════════════ -->
            <Border Style="{DynamicResource CardStyle}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="&#x1F4F7;  Screenshot Tool  (Screenshot tab)"
                               FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentBrush}"
                               Margin="0,0,0,8"/>
                    <TextBlock TextWrapping="Wrap" FontSize="12"
                               Foreground="{DynamicResource FgSecondaryBrush}" Margin="0,0,0,8"
                               Text="Capture your screen in three modes. Screenshots are auto-saved to the folder configured in Settings &#x2192; Paths."/>
                    <TextBlock TextWrapping="Wrap" FontSize="12"
                               Foreground="{DynamicResource FgSecondaryBrush}" Margin="8,0,0,0">
                        <Run FontWeight="Bold">Full Screen:</Run>
                        <Run> Captures the entire display. Shortcut: </Run>
                        <Run FontFamily="Consolas" Foreground="{DynamicResource AccentBrush}">Ctrl+Shift+S</Run><Run>.</Run><LineBreak/>
                        <Run FontWeight="Bold">Active Window:</Run>
                        <Run> Captures only the currently focused window.</Run><LineBreak/>
                        <Run FontWeight="Bold">Region:</Run>
                        <Run> Click and drag to select a specific area.</Run><LineBreak/>
                        <Run FontWeight="Bold">Save folder:</Run>
                        <Run> Settings &#x2192; Executable Paths &#x2192; Screenshot Save Folder &#x2192; Browse.</Run>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- ══════════════════════════════════════════════════════════
                 HEARTBEAT MONITOR — detailed
            ══════════════════════════════════════════════════════════ -->
            <Border Style="{DynamicResource CardStyle}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="&#x1F493;  Heartbeat Monitor  (Heartbeat tab)"
                               FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentBrush}"
                               Margin="0,0,0,6"/>
                    <TextBlock TextWrapping="Wrap" FontSize="12"
                               Foreground="{DynamicResource FgSecondaryBrush}" Margin="0,0,0,10"
                               Text="Periodically checks whether a list of processes or URLs are alive. Shows live status and optionally auto-restarts dead processes."/>

                    <!-- Step by step -->
                    <TextBlock FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource FgPrimaryBrush}" Margin="0,0,0,6"
                               Text="Step-by-step: Adding and monitoring a target"/>

                    <Border Background="{DynamicResource BgMainBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="4"
                            Padding="14,10" Margin="0,0,0,10">
                        <TextBlock TextWrapping="Wrap" FontSize="12"
                                   Foreground="{DynamicResource FgSecondaryBrush}" LineHeight="20">
                            <Run FontWeight="Bold">Step 1</Run>
                            <Run> — Go to the </Run><Run FontWeight="Bold">Heartbeat</Run><Run> tab.</Run><LineBreak/>

                            <Run FontWeight="Bold">Step 2</Run>
                            <Run> — In the form at the bottom, fill in:</Run><LineBreak/>
                            <Run>          </Run>
                            <Run FontWeight="Bold">Name:</Run>
                            <Run> A friendly label (e.g. </Run><Run FontStyle="Italic">My App</Run><Run> or </Run>
                            <Run FontStyle="Italic">Google</Run><Run>).</Run><LineBreak/>
                            <Run>          </Run>
                            <Run FontWeight="Bold">Target:</Run>
                            <Run> For a </Run><Run FontWeight="Bold">Process</Run>
                            <Run>: the process name </Run><Run FontStyle="Italic">without</Run>
                            <Run> .exe (e.g. </Run>
                            <Run FontFamily="Consolas" Foreground="{DynamicResource AccentBrush}">notepad</Run>
                            <Run>, </Run>
                            <Run FontFamily="Consolas" Foreground="{DynamicResource AccentBrush}">chrome</Run>
                            <Run>).</Run><LineBreak/>
                            <Run>                     For a </Run><Run FontWeight="Bold">Url</Run>
                            <Run>: the full URL including protocol (e.g. </Run>
                            <Run FontFamily="Consolas" Foreground="{DynamicResource AccentBrush}">https://www.google.com</Run><Run>).</Run><LineBreak/>
                            <Run>          </Run>
                            <Run FontWeight="Bold">Type:</Run>
                            <Run> Select </Run><Run FontWeight="Bold">Process</Run>
                            <Run> or </Run><Run FontWeight="Bold">Url</Run><Run> from the dropdown.</Run><LineBreak/>

                            <Run FontWeight="Bold">Step 3</Run>
                            <Run> — Click </Run><Run FontWeight="Bold">+ Add Target</Run>
                            <Run>. The entry appears in the list above.</Run><LineBreak/>

                            <Run FontWeight="Bold">Step 4</Run>
                            <Run> — Adjust the </Run><Run FontWeight="Bold">Check interval</Run>
                            <Run> slider (5–300 seconds).</Run><LineBreak/>

                            <Run FontWeight="Bold">Step 5</Run>
                            <Run> — Click </Run><Run FontWeight="Bold">Start Monitoring</Run><Run>.</Run><LineBreak/>

                            <Run FontWeight="Bold">Step 6</Run>
                            <Run> — Watch the Status column:</Run><LineBreak/>
                            <Run>          </Run>
                            <Run Foreground="#4CAF50" FontWeight="Bold">&#x2705;  Alive</Run>
                            <Run> = process is running / URL returned 2xx.</Run><LineBreak/>
                            <Run>          </Run>
                            <Run Foreground="#F44336" FontWeight="Bold">&#x274C;  Dead</Run>
                            <Run> = process not found / URL unreachable.</Run><LineBreak/>
                            <Run>          </Run>
                            <Run FontWeight="Bold">&#x2753;  Unknown</Run>
                            <Run> = not yet checked (waiting for first poll).</Run>
                        </TextBlock>
                    </Border>

                    <!-- Auto-Restart -->
                    <TextBlock FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource FgPrimaryBrush}" Margin="0,0,0,4"
                               Text="Auto-Restart feature:"/>
                    <TextBlock TextWrapping="Wrap" FontSize="12"
                               Foreground="{DynamicResource FgSecondaryBrush}" Margin="8,0,0,8">
                        <Run>Check </Run><Run FontWeight="Bold">Auto-Restart on death</Run>
                        <Run> to have DevPilot relaunch a dead process automatically.</Run><LineBreak/>
                        <Run FontWeight="Bold">Important:</Run>
                        <Run> For auto-restart to work, the </Run><Run FontWeight="Bold">Target</Run>
                        <Run> must be the </Run><Run FontStyle="Italic">full path to the .exe</Run>
                        <Run> (e.g. </Run>
                        <Run FontFamily="Consolas" Foreground="{DynamicResource AccentBrush}">C:\Windows\notepad.exe</Run>
                        <Run>), not just the process name.</Run>
                    </TextBlock>

                    <!-- Tips -->
                    <TextBlock FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource FgPrimaryBrush}" Margin="0,0,0,4"
                               Text="Tips:"/>
                    <TextBlock TextWrapping="Wrap" FontSize="12"
                               Foreground="{DynamicResource FgSecondaryBrush}" Margin="8,0,0,0">
                        <Run>&#x2022; Find process names: open </Run>
                        <Run FontWeight="Bold">Task Manager &#x2192; Details tab</Run>
                        <Run> — the Name column shows the exact exe name (remove the .exe).</Run><LineBreak/>
                        <Run>&#x2022; URL check: DevPilot sends an HTTP GET; any 2xx response is Alive.</Run><LineBreak/>
                        <Run>&#x2022; Monitoring continues even when you switch to another tab.</Run><LineBreak/>
                        <Run>&#x2022; To remove a target: click the </Run>
                        <Run FontWeight="Bold">&#x2715;</Run><Run> button on its row.</Run><LineBreak/>
                        <Run>&#x2022; Persistent targets: save in </Run>
                        <Run FontWeight="Bold">Settings &#x2192; Heartbeat &#x2192; Save Settings</Run><Run>.</Run>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- ══════════════════════════════════════════════════════════
                 SETTINGS
            ══════════════════════════════════════════════════════════ -->
            <Border Style="{DynamicResource CardStyle}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="&#x2699;  Settings tab"
                               FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentBrush}"
                               Margin="0,0,0,8"/>
                    <TextBlock TextWrapping="Wrap" FontSize="12"
                               Foreground="{DynamicResource FgSecondaryBrush}" LineHeight="20">
                        <Run FontWeight="Bold">General:</Run>
                        <Run> Dark / Light theme (applied instantly) &#x2022; Start with Windows &#x2022; Minimize to tray on close.</Run><LineBreak/>
                        <Run FontWeight="Bold">Tab Visibility:</Run>
                        <Run> Hide/show individual tabs. Services keep running when a tab is hidden.</Run><LineBreak/>
                        <Run FontWeight="Bold">Executable Paths:</Run>
                        <Run> Set paths for all 3 external tools and the Screenshot save folder. Use Browse to pick files.</Run><LineBreak/>
                        <Run FontWeight="Bold">Hotkeys:</Run>
                        <Run> View and change global shortcut bindings.</Run><LineBreak/>
                        <Run FontWeight="Bold">Mouse Jiggler:</Run>
                        <Run> Set default interval and method.</Run><LineBreak/>
                        <Run FontWeight="Bold">Heartbeat:</Run>
                        <Run> Set default check interval and manage persistent targets.</Run><LineBreak/>
                        <Run FontWeight="Bold">Save Settings:</Run>
                        <Run> Persists all changes to </Run>
                        <Run FontFamily="Consolas">%AppData%\DevPilot\config.json</Run><Run>.</Run><LineBreak/>
                        <Run FontWeight="Bold">Reset to Defaults:</Run>
                        <Run> Restores factory settings (requires confirmation).</Run>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- ══════════════════════════════════════════════════════════
                 SYSTEM TRAY
            ══════════════════════════════════════════════════════════ -->
            <Border Style="{DynamicResource CardStyle}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="&#x1F5A5;  System Tray"
                               FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentBrush}"
                               Margin="0,0,0,8"/>
                    <TextBlock TextWrapping="Wrap" FontSize="12"
                               Foreground="{DynamicResource FgSecondaryBrush}" LineHeight="20">
                        <Run>&#x2022; When </Run><Run FontWeight="Bold">Minimize to tray on close</Run>
                        <Run> is checked, pressing X hides the window — DevPilot stays running in the tray.</Run><LineBreak/>
                        <Run>&#x2022; </Run><Run FontWeight="Bold">Right-click</Run>
                        <Run> the tray icon for the context menu: Show Window &#x2022; Start/Stop Jiggler &#x2022; Exit.</Run><LineBreak/>
                        <Run>&#x2022; </Run><Run FontWeight="Bold">Double-click</Run>
                        <Run> the tray icon to restore the main window.</Run><LineBreak/>
                        <Run>&#x2022; </Run><Run FontWeight="Bold">Phase 12 (coming soon):</Run>
                        <Run> Configurable tray shortcuts — add your App Launcher entries directly to the tray menu.</Run>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- ══════════════════════════════════════════════════════════
                 VERSION / ABOUT
            ══════════════════════════════════════════════════════════ -->
            <Border Style="{DynamicResource CardStyle}" Margin="0,0,0,0">
                <StackPanel>
                    <TextBlock Text="&#x2139;  About DevPilot"
                               FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentBrush}"
                               Margin="0,0,0,6"/>
                    <TextBlock TextWrapping="Wrap" FontSize="12"
                               Foreground="{DynamicResource FgSecondaryBrush}" LineHeight="18">
                        <Run FontWeight="Bold">Version:</Run><Run> 1.0.0</Run><LineBreak/>
                        <Run FontWeight="Bold">Author:</Run><Run> Bogdan Murar (Z003FU5C) — Siemens AG</Run><LineBreak/>
                        <Run FontWeight="Bold">Platform:</Run><Run> C# WPF .NET 8 &#x2022; MVVM + DI &#x2022; Windows x64</Run><LineBreak/>
                        <Run FontWeight="Bold">Config file:</Run>
                        <Run FontFamily="Consolas"> %AppData%\DevPilot\config.json</Run><LineBreak/>
                        <Run FontWeight="Bold">Phases complete:</Run>
                        <Run> 1–10 of 16 &#x2022; Phase 11 next: Color Palette Audit</Run>
                    </TextBlock>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>