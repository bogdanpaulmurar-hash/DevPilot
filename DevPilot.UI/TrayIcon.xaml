<!-- ============================================================
     DevPilot — IT Automation Hub v1.0
     TrayIcon.xaml — System Tray icon + context menu
     Phase: 10 (Fix: Tag moved to TaskbarIcon — correct Hardcodet binding pattern)
     Author: Bogdan Murar (Z003FU5C) — Siemens AG
     ============================================================ -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:tb="http://www.hardcodet.net/taskbar">

    <!--
        BINDING PATTERN (Hardcodet):
        Tag="{Binding}" is set on the TaskbarIcon itself.
        ContextMenu.PlacementTarget IS the TaskbarIcon at runtime.
        PlacementTarget.Tag therefore resolves to TrayViewModel.
        DataContext is set on the TaskbarIcon in App.xaml.cs.
    -->
    <tb:TaskbarIcon x:Key="TrayIcon"
                    x:Shared="false"
                    Tag="{Binding}"
                    IconSource="/Assets/icon.ico"
                    ToolTipText="DevPilot — IT Automation Hub"
                    MenuActivation="RightClick"
                    DoubleClickCommand="{Binding ShowWindowCommand}">

        <tb:TaskbarIcon.ContextMenu>
            <ContextMenu>

                <!-- Header (disabled — acts as title) -->
                <MenuItem Header="DevPilot — IT Automation Hub"
                          FontWeight="Bold"
                          IsEnabled="False"/>
                <Separator/>

                <!-- Show main window -->
                <MenuItem Header="Show Window"
                          Command="{Binding PlacementTarget.Tag.ShowWindowCommand,
                                   RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                <Separator/>

                <!-- Jiggler toggle — label changes with IsRunning state -->
                <MenuItem Header="{Binding PlacementTarget.Tag.JigglerMenuLabel,
                                  RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                          Command="{Binding PlacementTarget.Tag.ToggleJigglerCommand,
                                   RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                <Separator/>

                <!-- Exit -->
                <MenuItem Header="Exit DevPilot"
                          Command="{Binding PlacementTarget.Tag.ExitCommand,
                                   RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>

            </ContextMenu>
        </tb:TaskbarIcon.ContextMenu>

    </tb:TaskbarIcon>

</ResourceDictionary>
