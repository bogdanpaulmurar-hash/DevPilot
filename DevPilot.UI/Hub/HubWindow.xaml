<Window x:Class="DevPilot.UI.Hub.HubWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hub="clr-namespace:DevPilot.UI.Hub"
        Title="DevPilot hub"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize" ShowActivated="True"
        SizeToContent="WidthAndHeight"
        MaxHeight="{Binding PanelMaxHeight}"
        Opacity="{Binding PanelOpacity}"
        FontFamily="{StaticResource UiFont}" FontSize="{Binding BaseFontSize}"
        Foreground="{DynamicResource TextBrush}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <!-- Tool row -->
        <DataTemplate x:Key="ToolRow" DataType="{x:Type hub:HubToolVM}">
            <Border x:Name="Row" Background="Transparent" CornerRadius="6" Margin="4,1"
                    Padding="{Binding DataContext.RowPadding, RelativeSource={RelativeSource AncestorType=Window}}"
                    Visibility="{Binding IsVisible, Converter={StaticResource BoolToVis}}" Cursor="Hand"
                    ToolTip="{Binding ToolTipText}" ToolTipService.InitialShowDelay="1200" ToolTipService.Placement="Mouse"
                    MouseEnter="ToolRow_MouseEnter" MouseLeftButtonUp="ToolRow_Click" MouseRightButtonUp="ToolRow_RightClick">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <!-- colour marker (only when the user picked a colour) -->
                    <Border Width="3" Height="16" CornerRadius="1.5" Margin="0,0,7,0" VerticalAlignment="Center"
                            Background="{Binding Color, Converter={StaticResource HexToBrush}}"
                            Visibility="{Binding HasColor, Converter={StaticResource BoolToVis}}"/>
                    <!-- logo or symbol (left out for "name only" rows) -->
                    <Grid Grid.Column="1" Width="{Binding LeadWidth}" Visibility="{Binding ShowLead, Converter={StaticResource BoolToVis}}">
                        <TextBlock x:Name="RowGlyph" Text="{Binding Glyph}" Style="{StaticResource Glyph}" FontSize="14" HorizontalAlignment="Left" TextAlignment="Left"
                                   Visibility="{Binding ShowGlyph, Converter={StaticResource BoolToVis}}"/>
                        <Image Source="{Binding Logo}" Width="{Binding LogoSize}" Height="{Binding LogoSize}" Stretch="Uniform"
                               HorizontalAlignment="Left" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"
                               Visibility="{Binding ShowLogo, Converter={StaticResource BoolToVis}}"/>
                    </Grid>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Visibility="{Binding ShowName, Converter={StaticResource BoolToVis}}">
                        <TextBlock x:Name="RowName" Text="{Binding Name}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextBrush}"
                                   FontWeight="{Binding Bold, Converter={StaticResource BoolToWeight}}"
                                   FontStyle="{Binding Italic, Converter={StaticResource BoolToStyle}}"/>
                        <TextBlock Text="{Binding Description}" FontSize="11.5" Foreground="{DynamicResource TextTertiaryBrush}"
                                   TextTrimming="CharacterEllipsis" Visibility="{Binding ShowDescription, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                    <Ellipse Grid.Column="3" Width="7" Height="7" Margin="8,0,2,0" VerticalAlignment="Center"
                             Fill="{Binding State, Converter={StaticResource RunStateBrush}}"
                             Visibility="{Binding ShowStatus, Converter={StaticResource BoolToVis}}"
                             ToolTip="{Binding StatusText}"/>
                    <TextBlock Grid.Column="4" Text="&#xE76C;" Style="{StaticResource Glyph}" FontSize="9" Margin="8,0,0,0" Opacity="0.7"
                               Visibility="{Binding HasFlyout, Converter={StaticResource BoolToVis}}"/>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <!-- Custom colours (already checked for readability in the view model). Hover stays last so it wins. -->
                <DataTrigger Binding="{Binding HasHighlight}" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="{Binding HighlightColor, Converter={StaticResource HexToBrush}}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding HasTextColor}" Value="True">
                    <Setter TargetName="RowName" Property="Foreground" Value="{Binding TextColor, Converter={StaticResource HexToBrush}}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding HasGlyphColor}" Value="True">
                    <Setter TargetName="RowGlyph" Property="Foreground" Value="{Binding GlyphColor, Converter={StaticResource HexToBrush}}"/>
                </DataTrigger>
                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource HoverBrush}"/>
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Separator row: a line, a gap, or a caption followed by a line -->
        <DataTemplate x:Key="SeparatorRow" DataType="{x:Type hub:HubToolVM}">
            <Grid Margin="14,2" MinHeight="{Binding SeparatorHeight}" Visibility="{Binding IsVisible, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="SepLabel" Text="{Binding SeparatorLabel}" FontSize="11" Margin="0,2,8,2" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextTertiaryBrush}" TextTrimming="CharacterEllipsis"
                           Visibility="{Binding ShowSeparatorLabel, Converter={StaticResource BoolToVis}}"/>
                <Border x:Name="SepLine" Grid.Column="1" Height="1" VerticalAlignment="Center" Background="{DynamicResource BorderBrush}"
                        Visibility="{Binding ShowSeparatorLine, Converter={StaticResource BoolToVis}}"/>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding HasSeparatorColor}" Value="True">
                    <Setter TargetName="SepLine" Property="Background" Value="{Binding SeparatorColor, Converter={StaticResource HexToBrush}}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding HasSeparatorTextColor}" Value="True">
                    <Setter TargetName="SepLabel" Property="Foreground" Value="{Binding SeparatorTextColor, Converter={StaticResource HexToBrush}}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <hub:HubRowTemplateSelector x:Key="RowSelector" Row="{StaticResource ToolRow}" Separator="{StaticResource SeparatorRow}"/>

        <Style x:Key="GroupHeaderButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="5" Padding="10,8,10,4" Margin="4,0">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SpotButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                CornerRadius="7" Padding="4,8" Margin="3">
                            <ContentPresenter HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource SpotlightBrush}"/>
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SpotlightSoftBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="Panel" Margin="10" Width="{Binding PanelWidth}" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderStrongBrush}"
            BorderThickness="1" CornerRadius="{Binding PanelCorner}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.35" Color="Black"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Margin="14,10,8,6" MouseLeftButtonDown="Header_MouseDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="20" Height="20" CornerRadius="5" Background="{DynamicResource AccentBrush}" Margin="0,0,8,0">
                        <TextBlock Text="&#xE945;" Style="{StaticResource Glyph}" FontSize="11" Foreground="{DynamicResource AccentForegroundBrush}"/>
                    </Border>
                    <TextBlock Text="DevPilot" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <ToggleButton Style="{StaticResource IconToggle}" Content="&#xE706;" IsChecked="{Binding KeepAwakeOn}" ToolTip="{Binding KeepAwakeStatus}"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE8A7;" Command="{Binding OpenMainCommand}" ToolTip="Open DevPilot"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE713;" Command="{Binding OpenSettingsCommand}" ToolTip="Customize the hub"/>
                    <ToggleButton Style="{StaticResource IconToggle}" Content="&#xE718;" IsChecked="{Binding IsPinned}" ToolTip="Keep the hub open"/>
                </StackPanel>
            </Grid>

            <!-- Search -->
            <Grid Grid.Row="1" Margin="12,2,12,8" Visibility="{Binding ShowSearch, Converter={StaticResource BoolToVis}}">
                <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Padding="30,5,28,5"
                         PreviewKeyDown="SearchBox_PreviewKeyDown"/>
                <TextBlock Text="&#xE721;" Style="{StaticResource Glyph}" FontSize="12" HorizontalAlignment="Left" Margin="10,0,0,0" IsHitTestVisible="False"/>
                <TextBlock Text="Search tools and actions…" Foreground="{DynamicResource TextTertiaryBrush}" Margin="31,0,0,0" VerticalAlignment="Center"
                           IsHitTestVisible="False" Visibility="{Binding SearchText, Converter={StaticResource BoolToVisInv}}"/>
                <Button Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="10" Width="24" Height="24" HorizontalAlignment="Right" Margin="0,0,3,0"
                        Command="{Binding ClearSearchCommand}" Visibility="{Binding SearchText, Converter={StaticResource BoolToVis}}"/>
            </Grid>

            <!-- Spotlight (ScreenPilot) -->
            <Border Grid.Row="2" Margin="10,0,10,8" CornerRadius="9" BorderThickness="1"
                    BorderBrush="{DynamicResource SpotlightBrush}" Background="{DynamicResource SpotlightSoftBrush}"
                    Visibility="{Binding DataContext.HasSpotlight, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"
                    DataContext="{Binding Spotlight}">
                <StackPanel Margin="10,10,10,8">
                    <Grid x:Name="SpotHeader" Background="Transparent" Cursor="Hand" MouseEnter="SpotHeader_MouseEnter" MouseLeftButtonUp="SpotHeader_Click">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource SpotlightBrush}">
                            <TextBlock Text="{Binding Tool.Glyph}" Style="{StaticResource Glyph}" FontSize="16" Foreground="{DynamicResource SpotlightForegroundBrush}"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Tool.Name}" FontWeight="SemiBold" FontSize="14"/>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="6" Height="6" Margin="0,1,6,0" Fill="{Binding Tool.State, Converter={StaticResource RunStateBrush}}"/>
                                <TextBlock Text="{Binding Tool.StatusText}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource IconButton}" Content="&#xE838;" Command="{Binding FolderCommand}" ToolTip="Captures folder"/>
                            <Button Style="{StaticResource IconButton}" Content="&#xE8A7;" Command="{Binding OpenCommand}" ToolTip="Open ScreenPilot"/>
                            <TextBlock Text="&#xE76C;" Style="{StaticResource Glyph}" FontSize="9" Margin="4,0,2,0" Opacity="0.7"/>
                        </StackPanel>
                    </Grid>

                    <ItemsControl ItemsSource="{Binding Featured}" Margin="-3,8,-3,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type hub:SpotlightActionVM}">
                                <Button Style="{StaticResource SpotButton}" Command="{Binding Command}" ToolTip="{Binding Label}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Glyph}" Style="{StaticResource Glyph}" FontSize="17" Foreground="{DynamicResource TextBrush}"
                                                   Visibility="{Binding DataContext.LargeButtons, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource BoolToVis}}"/>
                                        <TextBlock Text="{Binding Label}" FontSize="11" Margin="0,4,0,0" TextAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <ItemsControl ItemsSource="{Binding Recent}" Margin="-3,6,-3,0" Visibility="{Binding HasRecent, Converter={StaticResource BoolToVis}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type hub:RecentCaptureVM}">
                                <Button Command="{Binding OpenCommand}" ToolTip="{Binding ToolTip}" Cursor="Hand" Margin="3">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bd" Height="46" CornerRadius="5" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}"
                                                    Background="{DynamicResource Surface2Brush}" ClipToBounds="True">
                                                <Grid>
                                                    <Image Source="{Binding Thumb}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                    <TextBlock Text="&#xE714;" Style="{StaticResource Glyph}" FontSize="16"
                                                               Visibility="{Binding IsVideo, Converter={StaticResource BoolToVis}}"/>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource SpotlightBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Groups -->
            <ScrollViewer Grid.Row="3" x:Name="GroupsScroller" VerticalScrollBarVisibility="Auto" Padding="0,0,0,6" ScrollChanged="GroupsScroller_ScrollChanged">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding Groups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type hub:HubGroupVM}">
                                <StackPanel Visibility="{Binding HasVisibleTools, Converter={StaticResource BoolToVis}}" Margin="0,0,0,2">
                                    <Border CornerRadius="5" Margin="4,0" Background="{Binding HighlightColor, Converter={StaticResource HexToBrush}}"
                                            Visibility="{Binding HeaderVisible, Converter={StaticResource BoolToVis}}">
                                    <Button Style="{StaticResource GroupHeaderButton}" Margin="-4,0" Command="{Binding ToggleCommand}" MouseEnter="GroupHeader_MouseEnter">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Width="6" Height="6" Margin="0,0,7,0" VerticalAlignment="Center"
                                                     Fill="{Binding Color, Converter={StaticResource HexToBrush}}"
                                                     Visibility="{Binding HasColor, Converter={StaticResource BoolToVis}}"/>
                                            <TextBlock x:Name="GroupGlyph" Grid.Column="1" Text="{Binding Glyph}" Style="{StaticResource Glyph}" FontSize="11" Margin="0,0,6,0"
                                                       Foreground="{DynamicResource TextTertiaryBrush}" Visibility="{Binding HasGlyph, Converter={StaticResource BoolToVis}}"/>
                                            <TextBlock x:Name="Title" Grid.Column="2" Text="{Binding Title}" Foreground="{DynamicResource TextTertiaryBrush}"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                       FontWeight="{Binding HeaderBold, Converter={StaticResource BoolToWeight}}"/>
                                            <TextBlock Grid.Column="3" Text="{Binding CountText}" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" Margin="6,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="4" Text="{Binding ChevronGlyph}" Style="{StaticResource Glyph}" FontSize="9" Foreground="{DynamicResource TextTertiaryBrush}"/>
                                        </Grid>
                                    </Button>
                                    </Border>
                                    <ItemsControl ItemsSource="{Binding Tools}" ItemTemplateSelector="{StaticResource RowSelector}"
                                                  Visibility="{Binding IsCollapsed, Converter={StaticResource BoolToVisInv}}"/>
                                </StackPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding HeaderSmall}" Value="True">
                                        <Setter TargetName="Title" Property="FontSize" Value="11"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding HasTextColor}" Value="True">
                                        <Setter TargetName="Title" Property="Foreground" Value="{Binding TextColor, Converter={StaticResource HexToBrush}}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding HasGlyphColor}" Value="True">
                                        <Setter TargetName="GroupGlyph" Property="Foreground" Value="{Binding GlyphColor, Converter={StaticResource HexToBrush}}"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Empty states -->
                    <StackPanel Margin="20,16" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="No tools yet" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <TextBlock Text="Add your apps, scripts and folders, then group them the way you like." Style="{StaticResource Hint}" TextAlignment="Center"/>
                        <Button Content="Add tools" Style="{StaticResource AccentButton}" Command="{Binding AddToolCommand}" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                    </StackPanel>
                    <TextBlock Text="Nothing matches your search." Style="{StaticResource Hint}" HorizontalAlignment="Center" Margin="0,12"
                               Visibility="{Binding NoResults, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
            </ScrollViewer>

            <!-- Footer -->
            <Border Grid.Row="4" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="12,6,6,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="6" Height="6" Margin="0,0,7,0" Fill="{DynamicResource AccentBrush}"
                                 Visibility="{Binding KeepAwakeOn, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Text="{Binding KeepAwakeStatus, StringFormat='Keep-awake: {0}'}" FontSize="11.5" Foreground="{DynamicResource TextTertiaryBrush}"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE7E8;" Command="{Binding ExitCommand}" ToolTip="Exit DevPilot"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
