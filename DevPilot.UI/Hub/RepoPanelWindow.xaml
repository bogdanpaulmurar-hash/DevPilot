<Window x:Class="DevPilot.UI.Hub.RepoPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DevPilot.UI.ViewModels"
        Title="DevPilot repositories"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize" SizeToContent="Height"
        Width="480" MaxHeight="620"
        FontFamily="{StaticResource UiFont}" Foreground="{DynamicResource TextBrush}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Border Margin="10" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderStrongBrush}"
            BorderThickness="1" CornerRadius="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.35" Color="Black"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Margin="14,10,8,4" MouseLeftButtonDown="Header_MouseDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Repositories" FontWeight="SemiBold" FontSize="14"/>
                    <TextBlock Text="{Binding StatusLine}" Style="{StaticResource Hint}" Margin="0,1,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button Style="{StaticResource IconButton}" Content="&#xE713;" Command="{Binding OpenPageCommand}" ToolTip="Folder, commands and automatic pull (DevPilot > Repositories)"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE711;" Click="Close_Click" ToolTip="Close"/>
                </StackPanel>
            </Grid>

            <!-- Toolbar -->
            <Grid Grid.Row="1" Margin="14,4,14,6" Visibility="{Binding HasRoot, Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Horizontal">
                    <Button Content="All" Style="{StaticResource GhostButton}" Margin="0,0,4,0" Command="{Binding SelectAllCommand}"/>
                    <Button Content="None" Style="{StaticResource GhostButton}" Margin="0,0,4,0" Command="{Binding SelectNoneCommand}"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE72C;" Command="{Binding RescanCommand}" ToolTip="Scan the folder again"/>
                </StackPanel>
                <Button Content="Pull selected" Style="{StaticResource AccentButton}" HorizontalAlignment="Right"
                        Command="{Binding PullAllCommand}" IsEnabled="{Binding IsIdle}"/>
            </Grid>

            <!-- List -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,0,0,4">
                <StackPanel>
                    <StackPanel Margin="14,6,14,10" Visibility="{Binding NoRoot, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="No folder chosen yet." TextWrapping="Wrap"/>
                        <Button Content="Choose the folder with your clones" Style="{StaticResource AccentButton}" HorizontalAlignment="Left" Margin="0,8,0,0"
                                Command="{Binding OpenPageCommand}"/>
                    </StackPanel>
                    <TextBlock Text="No git repositories found in the folder." Style="{StaticResource Hint}" Margin="14,6,14,10"
                               Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}"/>
                    <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:RepoRowVM}">
                                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="14,7">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Top" Margin="0,2,10,0" ToolTip="Include in Pull selected"/>
                                        <StackPanel Grid.Column="1">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Branch}" Style="{StaticResource Hint}" FontFamily="{StaticResource MonoFont}" Margin="8,0,0,0"
                                                           Visibility="{Binding HasBranch, Converter={StaticResource BoolToVis}}"/>
                                                <TextBlock Text="{Binding Version}" ToolTip="{Binding VersionTip}" Style="{StaticResource Hint}" FontFamily="{StaticResource MonoFont}" Margin="8,0,0,0"
                                                           Visibility="{Binding HasVersion, Converter={StaticResource BoolToVis}}"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                <Ellipse x:Name="Mark" Width="7" Height="7" Margin="0,0,6,0" VerticalAlignment="Center" Fill="Transparent"/>
                                                <TextBlock Text="{Binding StatusText}" Style="{StaticResource Hint}"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Message}" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="13,1,0,0"
                                                       FontFamily="{StaticResource MonoFont}" Visibility="{Binding HasMessage, Converter={StaticResource BoolToVis}}"/>
                                        </StackPanel>
                                        <Button Grid.Column="2" Content="{Binding ActionLabel}" VerticalAlignment="Top" MinWidth="64" Margin="8,0,0,0"
                                                Command="{Binding RunCommand}" ToolTip="{Binding ActionTip}" IsEnabled="{Binding CanRun}"/>
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Tone}" Value="ok">
                                        <Setter TargetName="Mark" Property="Fill" Value="{DynamicResource StatusRunningBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Tone}" Value="updated">
                                        <Setter TargetName="Mark" Property="Fill" Value="{DynamicResource AccentBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Tone}" Value="skipped">
                                        <Setter TargetName="Mark" Property="Fill" Value="{DynamicResource StatusStartingBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Tone}" Value="failed">
                                        <Setter TargetName="Mark" Property="Fill" Value="{DynamicResource StatusFailedBrush}"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <TextBlock Grid.Row="3" Style="{StaticResource Hint}" Margin="14,2,14,10" TextWrapping="Wrap"
                       Text="The button on a row runs its action. With several actions (pull and commands) a menu with one button each opens. Esc closes."/>
        </Grid>
    </Border>
</Window>
