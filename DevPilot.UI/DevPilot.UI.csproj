<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>DevPilot</AssemblyName>
    <RootNamespace>DevPilot.UI</RootNamespace>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <SupportedOSPlatformVersion>7.0</SupportedOSPlatformVersion>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <!-- ── Release metadata ────────────────────────────────────────── -->
    <Version>1.0.0</Version>
    <Company>Siemens AG</Company>
    <Product>DevPilot</Product>
    <Description>DevPilot — IT Automation Hub</Description>
    <Copyright>© 2025 Bogdan Murar (Z003FU5C), Siemens AG</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DevPilot.Core\DevPilot.Core.csproj" />
    <ProjectReference Include="..\DevPilot.Models\DevPilot.Models.csproj" />
    <ProjectReference Include="..\DevPilot.Infrastructure\DevPilot.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection"  Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting"              Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging"              Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console"      Version="8.0.0" />
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf"                  Version="2.0.1" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\icon.ico" />
  </ItemGroup>

</Project>
